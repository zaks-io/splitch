{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Shared Stryker base. Per-package stryker.config.json extends this and sets `mutate`. Policy lives in docs/adr/0031.",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "coverageAnalysis": "perTest",
  "reporters": ["html", "clear-text", "progress"],
  "incremental": true,
  "incrementalFile": "reports/mutation/stryker-incremental.json",
  "ignorePatterns": ["dist", "coverage", ".turbo", "**/*.test.ts", "**/*.spec.ts"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
