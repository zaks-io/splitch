{
  "name": "splitch-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "turbo run build",
    "check:cli-mcp-parity": "pnpm --filter @splitch/cli exec tsx ../../scripts/check-cli-mcp-parity.ts",
    "clean": "turbo run clean && rm -rf node_modules .turbo coverage",
    "depcruise": "dependency-cruiser --config .dependency-cruiser.cjs \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "d1:migrate:local": "node scripts/check-d1-local.mjs",
    "d1:migrate:populated": "node scripts/check-d1-populated.mjs",
    "dev": "turbo run dev --parallel",
    "dev:api": "turbo run dev --parallel --filter=@splitch/analysis-api --filter=@splitch/auth-api --filter=@splitch/control-plane-api --filter=@splitch/evaluation-api --filter=@splitch/event-ingest-api --filter=@splitch/mcp-server",
    "duplicates": "jscpd --config .jscpd.json --exit-code --no-tips --no-colors apps packages scripts",
    "format:check": "biome format . && prettier --check \"**/*.md\"",
    "format:write": "biome format --write . && prettier --write \"**/*.md\"",
    "knip": "knip --treat-config-hints-as-errors",
    "lint": "turbo run lint",
    "prepare": "lefthook install",
    "audit": "pnpm audit --audit-level=high",
    "pins:check": "node scripts/security-check.mjs pinact run -check",
    "sast": "node scripts/security-check.mjs semgrep scan --config .semgrep/ --error apps packages scripts",
    "secrets:staged": "gitleaks git --redact --no-banner --staged .",
    "secrets:range": "node scripts/secrets-range.mjs",
    "secrets:git": "gitleaks git --redact --no-banner .",
    "security": "pnpm sast && pnpm pins:check && pnpm audit",
    "security:full": "pnpm sast && pnpm pins:check && pnpm audit && pnpm secrets:git",
    "shared-preview:cleanup-smoke": "node scripts/seed-shared-preview-smoke.mjs --cleanup-transient",
    "shared-preview:reset": "node scripts/reset-shared-preview.mjs",
    "shared-preview:seed-panel-user": "node scripts/seed-shared-preview-panel-user.mjs",
    "shared-preview:seed-smoke": "node scripts/seed-shared-preview-smoke.mjs",
    "sdk:release:check-prepare": "node scripts/release/check-prepare-artifacts-contract.mjs sdk",
    "sdk:release:prepare": "node scripts/release/prepare-artifacts.mjs sdk",
    "sdk:release:validate": "node scripts/release/validate-candidate.mjs sdk",
    "shared-preview:smoke": "playwright test -c tests/shared-preview/playwright.config.ts --project=api",
    "shared-preview:smoke:panel": "playwright test -c tests/shared-preview/playwright.config.ts --project=panel",
    "smoke:dark-launch:shared-preview": "node scripts/dark-launch/shared-preview-smoke.mjs",
    "smoke:safe-delivery:shared-preview": "node scripts/safe-delivery/shared-preview-smoke.mjs",
    "smoke:sdk-consumer": "pnpm --filter @splitch/sdk test:consumer-smoke",
    "smoke:connect-snippet": "pnpm --filter @splitch/control-panel test:connect-snippet",
    "claim:local-fleet": "playwright test -c tests/local-fleet/claim.playwright.config.ts",
    "smoke:ci": "node -e \"console.log('smoke:ci is deployment-workflow-only; run pnpm shared-preview:smoke against a deployed preview.')\"",
    "smoke:local": "node scripts/smoke-workers-local.mjs",
    "smoke:local:api": "node scripts/smoke-workers-local.mjs api",
    "spec:lint": "node scripts/spec-lint.mjs",
    "stats:audit": "turbo run stats:audit",
    "stats:golden": "turbo run stats:golden",
    "stats:property": "turbo run stats:property",
    "stats:simulation": "turbo run stats:simulation",
    "stats:unit": "turbo run stats:unit",
    "test": "turbo run test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:mutation": "turbo run test:mutation",
    "deploy:cloudflare:production": "pnpm deploy:cloudflare:event-ingest:production && pnpm deploy:cloudflare:analysis:production && pnpm deploy:cloudflare:control-plane-compat:production && pnpm deploy:cloudflare:evaluation:production && pnpm credential-cache:backfill:production && pnpm deploy:cloudflare:control-panel:production && pnpm deploy:cloudflare:control-plane:production && pnpm deploy:cloudflare:remaining:production",
    "deploy:cloudflare:shared-preview": "pnpm deploy:cloudflare:event-ingest:shared-preview && pnpm deploy:cloudflare:analysis:shared-preview && pnpm deploy:cloudflare:control-plane-compat:shared-preview && pnpm deploy:cloudflare:evaluation:shared-preview && pnpm credential-cache:backfill:shared-preview && pnpm deploy:cloudflare:control-panel:shared-preview && pnpm deploy:cloudflare:control-plane:shared-preview && pnpm deploy:cloudflare:remaining:shared-preview",
    "deploy:cloudflare:event-ingest:production": "turbo run deploy --filter=@splitch/event-ingest-api -- --env production --strict",
    "deploy:cloudflare:analysis:production": "turbo run deploy --filter=@splitch/analysis-api -- --env production --strict",
    "deploy:cloudflare:evaluation:production": "turbo run deploy --filter=@splitch/evaluation-api -- --env production --strict",
    "deploy:cloudflare:event-ingest:shared-preview": "turbo run deploy --filter=@splitch/event-ingest-api -- --env shared-preview --strict",
    "deploy:cloudflare:analysis:shared-preview": "turbo run deploy --filter=@splitch/analysis-api -- --env shared-preview --strict",
    "deploy:cloudflare:evaluation:shared-preview": "turbo run deploy --filter=@splitch/evaluation-api -- --env shared-preview --strict",
    "deploy:cloudflare:control-plane-compat:production": "node scripts/deploy-control-plane-compat.mjs production",
    "deploy:cloudflare:control-plane-compat:shared-preview": "node scripts/deploy-control-plane-compat.mjs shared-preview",
    "deploy:cloudflare:control-panel:production": "CLOUDFLARE_ENV=production SPLITCH_GENERATED_WRANGLER_ENV=production turbo run deploy --filter=@splitch/control-panel -- --env production --strict",
    "deploy:cloudflare:control-panel:shared-preview": "CLOUDFLARE_ENV=shared-preview SPLITCH_GENERATED_WRANGLER_ENV=shared-preview turbo run deploy --filter=@splitch/control-panel -- --env shared-preview --strict",
    "deploy:cloudflare:control-plane:production": "turbo run deploy --filter=@splitch/control-plane-api -- --env production --strict",
    "deploy:cloudflare:control-plane:shared-preview": "turbo run deploy --filter=@splitch/control-plane-api -- --env shared-preview --strict",
    "deploy:cloudflare:remaining:production": "CLOUDFLARE_ENV=production SPLITCH_GENERATED_WRANGLER_ENV=production turbo run deploy \"--filter=./apps/*\" \"--filter=!@splitch/cli\" \"--filter=!@splitch/analysis-api\" \"--filter=!@splitch/event-ingest-api\" \"--filter=!@splitch/evaluation-api\" \"--filter=!@splitch/control-panel\" \"--filter=!@splitch/control-plane-api\" -- --env production --strict",
    "deploy:cloudflare:remaining:shared-preview": "CLOUDFLARE_ENV=shared-preview SPLITCH_GENERATED_WRANGLER_ENV=shared-preview turbo run deploy \"--filter=./apps/*\" \"--filter=!@splitch/cli\" \"--filter=!@splitch/analysis-api\" \"--filter=!@splitch/event-ingest-api\" \"--filter=!@splitch/evaluation-api\" \"--filter=!@splitch/control-panel\" \"--filter=!@splitch/control-plane-api\" -- --env shared-preview --strict",
    "rollback:cloudflare:panel-binding:production": "node scripts/rollback-control-panel-binding.mjs production",
    "rollback:cloudflare:panel-binding:shared-preview": "node scripts/rollback-control-panel-binding.mjs shared-preview",
    "credential-cache:backfill:production": "node scripts/complete-credential-cache-backfill.mjs https://api.splitch.dev",
    "credential-cache:backfill:shared-preview": "node scripts/complete-credential-cache-backfill.mjs https://api.preview.splitch.dev",
    "deploy:dry-run:production": "CLOUDFLARE_ENV=production SPLITCH_GENERATED_WRANGLER_ENV=production turbo run deploy:dry-run \"--filter=./apps/*\" \"--filter=!@splitch/cli\" -- --env production --strict",
    "deploy:dry-run:shared-preview": "CLOUDFLARE_ENV=shared-preview SPLITCH_GENERATED_WRANGLER_ENV=shared-preview turbo run deploy:dry-run \"--filter=./apps/*\" \"--filter=!@splitch/cli\" -- --env shared-preview --strict",
    "deploy:production": "pnpm tinybird:deploy:production && pnpm d1:migrate:production && pnpm deploy:cloudflare:production",
    "deploy:shared-preview": "pnpm tinybird:build:shared-preview && pnpm d1:migrate:shared-preview && pnpm deploy:cloudflare:shared-preview",
    "d1:migrate:production": "turbo run migrate:production --filter=@splitch/db",
    "d1:migrate:shared-preview": "turbo run migrate:shared-preview --filter=@splitch/db",
    "tinybird:build:shared-preview": "tb --no-version-warning --branch shared_preview build",
    "tinybird:deploy:check": "tb --no-version-warning deploy --check",
    "tinybird:deploy:production": "node scripts/deploy-tinybird-production.mjs",
    "tinybird:local": "node scripts/check-tinybird-local.mjs",
    "workers:secrets:production": "node scripts/sync-worker-secrets.mjs production",
    "workers:secrets:shared-preview": "node scripts/sync-worker-secrets.mjs shared-preview",
    "typecheck": "turbo run typecheck",
    "verify:ci": "turbo run //#knip //#format:check //#spec:lint //#check:cli-mcp-parity //#test:scripts lint typecheck test test:connect-snippet stats:golden stats:property build",
    "verify:commit": "turbo run //#knip //#format:check //#secrets:staged lint typecheck",
    "verify:push": "turbo run //#knip //#format:check //#secrets:range //#tinybird:local //#d1:migrate:local //#d1:migrate:populated lint typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@playwright/test": "^1.62.0",
    "@sentry/cli": "^3.6.2",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "^26.1.2",
    "dependency-cruiser": "^18.1.0",
    "esbuild": "^0.28.1",
    "jscpd": "^5.0.12",
    "knip": "^6.24.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "seroval": "^1.5.6",
    "tsup": "^8.5.0",
    "turbo": "^2.10.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
