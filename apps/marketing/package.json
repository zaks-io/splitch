{
  "name": "@splitch/marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage .output .wrangler",
    "deploy": "node ../../scripts/deploy-vite-worker-with-sentry.mjs",
    "deploy:dry-run": "node ../../scripts/deploy-vite-worker-with-sentry.mjs --dry-run",
    "dev": "vite dev --host 127.0.0.1 --port 8794",
    "lint": "biome lint src vite.config.ts vitest.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 8794",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "wrangler:types": "wrangler types src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@sentry/react": "^10.72.0",
    "@splitch/cli": "workspace:*",
    "@splitch/contracts": "workspace:*",
    "@splitch/observability": "workspace:*",
    "@splitch/ui": "workspace:*",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "5.20260828.1",
    "@splitch/sdk": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2",
    "wrangler": "4.127.1"
  }
}
