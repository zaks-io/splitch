{
  "name": "@splitch/marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "deploy": "node ../../scripts/deploy-worker-with-sentry.mjs",
    "deploy:dry-run": "node ../../scripts/deploy-worker-with-sentry.mjs --dry-run",
    "dev": "wrangler dev --local --port 8794 --show-interactive-dev-session=false",
    "lint": "biome lint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "wrangler:types": "wrangler types src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@splitch/contracts": "workspace:*",
    "@splitch/ui": "workspace:*"
  }
}
