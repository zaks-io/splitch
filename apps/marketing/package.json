{
  "name": "@splitch/marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vitest run --config vitest.build.config.ts --maxWorkers=2 && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage .output .wrangler",
    "deploy": "node ../../scripts/deploy-vite-worker-with-sentry.mjs",
    "deploy:dry-run": "node ../../scripts/deploy-vite-worker-with-sentry.mjs --dry-run",
    "dev": "node ../../scripts/vite-dev.mjs dev --host 127.0.0.1 --port 8794",
    "lint": "biome lint src vite.config.ts vitest.config.ts vitest.build.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 8794",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "wrangler:types": "wrangler types src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@sentry/react": "^11.9.0",
    "@splitch/cli": "workspace:*",
    "@splitch/contracts": "workspace:*",
    "@splitch/observability": "workspace:*",
    "@splitch/ui": "workspace:*",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "5.20261025.1",
    "@splitch/sdk": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "wrangler": "4.152.0"
  }
}
