{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "splitch-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "traces": {
      "enabled": true,
      "destinations": ["axiom-traces"],
      "persist": false,
      "head_sampling_rate": 1
    },
    "logs": {
      "enabled": true,
      "destinations": ["axiom-logs"],
      "persist": false,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": [
      "SENTRY_DSN",
      "MCP_CONTROL_PLANE_DELEGATION_SECRET",
      "MCP_EVALUATION_DELEGATION_SECRET",
      "MCP_ANALYSIS_DELEGATION_SECRET"
    ]
  },
  "vars": {
    "SPLITCH_PLATFORM_TARGET": "local",
    "AUTH_API_ORIGIN": "http://localhost:8791",
    "CONTROL_PLANE_API_ORIGIN": "http://localhost:8787",
    "EVALUATION_API_ORIGIN": "http://127.0.0.1:8788"
  },
  "durable_objects": {
    "bindings": [{ "name": "MCP_SESSIONS", "class_name": "McpSessionDurableObject" }]
  },
  "migrations": [{ "tag": "v1", "new_classes": ["McpSessionDurableObject"] }],
  "env": {
    "shared-preview": {
      "name": "splitch-mcp-server-shared-preview",
      "workers_dev": false,
      "observability": {
        "traces": {
          "enabled": true,
          "destinations": ["axiom-traces"],
          "persist": false,
          "head_sampling_rate": 1
        },
        "logs": {
          "enabled": true,
          "destinations": ["axiom-logs"],
          "persist": false,
          "head_sampling_rate": 1
        }
      },
      "routes": [{ "pattern": "mcp.preview.splitch.dev", "custom_domain": true }],
      "secrets": {
        "required": [
          "SENTRY_DSN",
          "MCP_CONTROL_PLANE_DELEGATION_SECRET",
          "MCP_EVALUATION_DELEGATION_SECRET",
          "MCP_ANALYSIS_DELEGATION_SECRET"
        ]
      },
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "shared-preview",
        "AUTH_API_ORIGIN": "https://auth.preview.splitch.dev",
        "CONTROL_PLANE_API_ORIGIN": "https://api.preview.splitch.dev",
        "EVALUATION_API_ORIGIN": "https://edge.preview.splitch.dev"
      },
      "durable_objects": {
        "bindings": [{ "name": "MCP_SESSIONS", "class_name": "McpSessionDurableObject" }]
      },
      "migrations": [{ "tag": "v1", "new_classes": ["McpSessionDurableObject"] }],
      "services": [
        {
          "binding": "CONTROL_PLANE_API",
          "service": "splitch-control-plane-api-shared-preview",
          "entrypoint": "McpEntrypoint"
        },
        {
          "binding": "EVALUATION_API",
          "service": "splitch-evaluation-api-shared-preview",
          "entrypoint": "McpEntrypoint"
        },
        {
          "binding": "ANALYSIS_API",
          "service": "splitch-analysis-api-shared-preview",
          "entrypoint": "McpEntrypoint"
        }
      ]
    },
    "production": {
      "name": "splitch-mcp-server",
      "workers_dev": false,
      "observability": {
        "traces": {
          "enabled": true,
          "destinations": ["axiom-traces"],
          "persist": false,
          "head_sampling_rate": 1
        },
        "logs": {
          "enabled": true,
          "destinations": ["axiom-logs"],
          "persist": false,
          "head_sampling_rate": 1
        }
      },
      "routes": [{ "pattern": "mcp.splitch.dev", "custom_domain": true }],
      "secrets": {
        "required": [
          "SENTRY_DSN",
          "MCP_CONTROL_PLANE_DELEGATION_SECRET",
          "MCP_EVALUATION_DELEGATION_SECRET",
          "MCP_ANALYSIS_DELEGATION_SECRET"
        ]
      },
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "production",
        "AUTH_API_ORIGIN": "https://auth.splitch.dev",
        "CONTROL_PLANE_API_ORIGIN": "https://api.splitch.dev",
        "EVALUATION_API_ORIGIN": "https://edge.splitch.dev"
      },
      "durable_objects": {
        "bindings": [{ "name": "MCP_SESSIONS", "class_name": "McpSessionDurableObject" }]
      },
      "migrations": [{ "tag": "v1", "new_classes": ["McpSessionDurableObject"] }],
      "services": [
        {
          "binding": "CONTROL_PLANE_API",
          "service": "splitch-control-plane-api",
          "entrypoint": "McpEntrypoint"
        },
        {
          "binding": "EVALUATION_API",
          "service": "splitch-evaluation-api",
          "entrypoint": "McpEntrypoint"
        },
        {
          "binding": "ANALYSIS_API",
          "service": "splitch-analysis-api",
          "entrypoint": "McpEntrypoint"
        }
      ]
    }
  }
}
