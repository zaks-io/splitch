{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "splitch-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SPLITCH_PLATFORM_TARGET": "local",
    "CONTROL_PLANE_API_ORIGIN": "http://127.0.0.1:8787",
    "EVALUATION_API_ORIGIN": "http://127.0.0.1:8788",
    "ANALYSIS_API_ORIGIN": "http://127.0.0.1:8790",
    "AXIOM_DATASET": "splitch-logs"
  },
  "secrets": {
    "required": ["SENTRY_DSN", "AXIOM_TOKEN"]
  },
  "env": {
    "shared-preview": {
      "name": "splitch-mcp-server-shared-preview",
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "shared-preview",
        "AXIOM_DATASET": "splitch-logs"
      },
      "secrets": {
        "required": ["SENTRY_DSN", "AXIOM_TOKEN"]
      }
    },
    "production": {
      "name": "splitch-mcp-server",
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "production",
        "AXIOM_DATASET": "splitch-logs"
      },
      "secrets": {
        "required": ["SENTRY_DSN", "AXIOM_TOKEN"]
      }
    }
  }
}
