{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "splitch-auth-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // D1 carries the trusted-IdP allow-list + Org membership (accessed only through
  // @splitch/db createRepository). KV backs the jti replay cache (`jti:{jti}`)
  // and the shared control-plane session revocation markers (`revoked:{sub}`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitch-d1",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "JTI_CACHE",
      "id": "00000000000000000000000000000000"
    },
    {
      "binding": "SESSION_STORE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "vars": {
    "SPLITCH_PLATFORM_TARGET": "local",
    "AUTH_API_ORIGIN": "http://localhost:8791",
    "CONTROL_PLANE_ORIGIN": "http://localhost:8787",
    "AXIOM_DATASET": "splitch-logs"
  },
  "secrets": {
    "required": ["SENTRY_DSN", "AXIOM_TOKEN"]
  },
  "env": {
    "shared-preview": {
      "name": "splitch-auth-api-shared-preview",
      "secrets": {
        "required": ["SENTRY_DSN", "AXIOM_TOKEN", "TURNSTILE_SECRET"]
      },
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "shared-preview",
        "TURNSTILE_SITE_KEY": "0x4AAAAAADsCXVP9TRrC6c6N",
        "AXIOM_DATASET": "splitch-logs"
      }
    },
    "production": {
      "name": "splitch-auth-api",
      "secrets": {
        "required": ["SENTRY_DSN", "AXIOM_TOKEN", "TURNSTILE_SECRET"]
      },
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "production",
        "TURNSTILE_SITE_KEY": "0x4AAAAAADsCY8JNBv2vrTFC",
        "AXIOM_DATASET": "splitch-logs"
      }
    }
  }
}
