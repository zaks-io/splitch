{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "splitch-auth-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "traces": {
      "enabled": true,
      "destinations": ["axiom-traces"],
      "persist": false,
      "head_sampling_rate": 1
    },
    "logs": {
      "enabled": true,
      "destinations": ["axiom-logs"],
      "persist": false,
      "head_sampling_rate": 1
    }
  },
  // D1 carries the trusted-IdP allow-list + Org membership (accessed only through
  // @splitch/db createRepository). KV backs the jti replay cache (`jti:{jti}`)
  // and the shared control-plane session revocation markers (`revoked:{sub}`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitch-d1",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "JTI_CACHE",
      "id": "00000000000000000000000000000000"
    },
    {
      "binding": "SESSION_STORE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "secrets": {
    "required": ["SENTRY_DSN"]
  },
  "vars": {
    "SPLITCH_PLATFORM_TARGET": "local",
    "AUTH_API_ORIGIN": "http://localhost:8791",
    "CONTROL_PLANE_ORIGIN": "http://localhost:8787"
  },
  "env": {
    "shared-preview": {
      "name": "splitch-auth-api-shared-preview",
      "workers_dev": false,
      "observability": {
        "traces": {
          "enabled": true,
          "destinations": ["axiom-traces"],
          "persist": false,
          "head_sampling_rate": 1
        },
        "logs": {
          "enabled": true,
          "destinations": ["axiom-logs"],
          "persist": false,
          "head_sampling_rate": 1
        }
      },
      "routes": [{ "pattern": "auth.preview.splitch.dev", "custom_domain": true }],
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "shared-preview",
        "AUTH_API_ORIGIN": "https://auth.preview.splitch.dev",
        "CONTROL_PLANE_ORIGIN": "https://api.preview.splitch.dev",
        "TURNSTILE_SITE_KEY": "0x4AAAAAADsCXVP9TRrC6c6N"
      },
      "secrets": {
        "required": [
          "SENTRY_DSN",
          "ACCESS_TOKEN_SECRET",
          "ASSERTION_SIGNING_SECRET",
          "TURNSTILE_SECRET",
          "WORKOS_CLIENT_ID",
          "WORKOS_API_KEY"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "splitch-shared-preview-d1",
          "database_id": "34971683-d76b-4fc0-9bc0-9e97f297fbec"
        }
      ],
      "kv_namespaces": [
        { "binding": "JTI_CACHE", "id": "04607132d6614c96bb44e7f67f873598" },
        { "binding": "SESSION_STORE", "id": "673d17e768eb45f5bfc5275fbd0e9320" }
      ]
    },
    "production": {
      "name": "splitch-auth-api",
      "workers_dev": false,
      "observability": {
        "traces": {
          "enabled": true,
          "destinations": ["axiom-traces"],
          "persist": false,
          "head_sampling_rate": 1
        },
        "logs": {
          "enabled": true,
          "destinations": ["axiom-logs"],
          "persist": false,
          "head_sampling_rate": 1
        }
      },
      "routes": [{ "pattern": "auth.splitch.dev", "custom_domain": true }],
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "production",
        "AUTH_API_ORIGIN": "https://auth.splitch.dev",
        "CONTROL_PLANE_ORIGIN": "https://api.splitch.dev",
        "TURNSTILE_SITE_KEY": "0x4AAAAAADsCY8JNBv2vrTFC"
      },
      "secrets": {
        "required": [
          "SENTRY_DSN",
          "ACCESS_TOKEN_SECRET",
          "ASSERTION_SIGNING_SECRET",
          "TURNSTILE_SECRET",
          "WORKOS_CLIENT_ID",
          "WORKOS_API_KEY"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "splitch-production-d1",
          "database_id": "f419e372-d548-4afb-966f-40ff298303d8"
        }
      ],
      "kv_namespaces": [
        { "binding": "JTI_CACHE", "id": "499e8d49082f43a48371c6784495a2ad" },
        { "binding": "SESSION_STORE", "id": "bdfa1197123d4eef945c5a703d63a572" }
      ]
    }
  }
}
