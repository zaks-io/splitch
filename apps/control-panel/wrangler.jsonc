{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "splitch-control-panel",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-07-05",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "traces": {
      "enabled": true,
      "destinations": ["axiom-traces"],
      "persist": false,
      "head_sampling_rate": 1
    },
    "logs": {
      "enabled": true,
      "destinations": ["axiom-logs"],
      "persist": false,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "SPLITCH_PLATFORM_TARGET": "local",
    "SENTRY_DSN": "https://3ab6a31eedba4a3aff8720d2b4442368@o4509987229859840.ingest.us.sentry.io/4511677909762048"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitch-d1",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_STORE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "secrets": {
    "required": ["WORKOS_API_KEY", "WORKOS_CLIENT_ID"]
  },
  "env": {
    "shared-preview": {
      "name": "splitch-control-panel-shared-preview",
      "workers_dev": false,
      "observability": {
        "traces": {
          "enabled": true,
          "destinations": ["axiom-traces"],
          "persist": false,
          "head_sampling_rate": 1
        },
        "logs": {
          "enabled": true,
          "destinations": ["axiom-logs"],
          "persist": false,
          "head_sampling_rate": 1
        }
      },
      "routes": [{ "pattern": "app.preview.splitch.dev", "custom_domain": true }],
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "shared-preview",
        "SENTRY_DSN": "https://3ab6a31eedba4a3aff8720d2b4442368@o4509987229859840.ingest.us.sentry.io/4511677909762048"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "splitch-shared-preview-d1",
          "database_id": "34971683-d76b-4fc0-9bc0-9e97f297fbec"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION_STORE",
          "id": "673d17e768eb45f5bfc5275fbd0e9320"
        }
      ],
      "secrets": {
        "required": ["WORKOS_API_KEY", "WORKOS_CLIENT_ID"]
      }
    },
    "production": {
      "name": "splitch-control-panel",
      "workers_dev": false,
      "observability": {
        "traces": {
          "enabled": true,
          "destinations": ["axiom-traces"],
          "persist": false,
          "head_sampling_rate": 1
        },
        "logs": {
          "enabled": true,
          "destinations": ["axiom-logs"],
          "persist": false,
          "head_sampling_rate": 1
        }
      },
      "routes": [{ "pattern": "app.splitch.dev", "custom_domain": true }],
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "production",
        "SENTRY_DSN": "https://3ab6a31eedba4a3aff8720d2b4442368@o4509987229859840.ingest.us.sentry.io/4511677909762048"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "splitch-production-d1",
          "database_id": "f419e372-d548-4afb-966f-40ff298303d8"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION_STORE",
          "id": "bdfa1197123d4eef945c5a703d63a572"
        }
      ],
      "secrets": {
        "required": ["WORKOS_API_KEY", "WORKOS_CLIENT_ID"]
      }
    }
  }
}
