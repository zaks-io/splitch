{
  "name": "@splitch/control-panel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage .output .wrangler",
    "deploy": "node ../../scripts/deploy-vite-worker-with-sentry.mjs",
    "deploy:dry-run": "node ../../scripts/deploy-vite-worker-with-sentry.mjs --dry-run",
    "dev": "vite dev --host 127.0.0.1 --port 8793",
    "lint": "biome lint src vite.config.ts vitest.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 8793",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "wrangler:types": "wrangler types src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.63.0",
    "@sentry/react": "^10.63.0",
    "@splitch/contracts": "workspace:*",
    "@splitch/db": "workspace:*",
    "@splitch/observability": "workspace:*",
    "@splitch/ui": "workspace:*",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "@workos-inc/node": "^10.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.3",
    "wrangler": "^4.107.0"
  }
}
