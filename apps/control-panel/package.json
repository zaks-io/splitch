{
  "name": "@splitch/control-panel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage .output .wrangler",
    "deploy": "node ../../scripts/deploy-vite-worker-with-sentry.mjs",
    "deploy:dry-run": "node ../../scripts/deploy-vite-worker-with-sentry.mjs --dry-run",
    "dev": "vite dev --host 127.0.0.1 --port 8793",
    "lint": "biome lint src vite.config.ts vitest.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 8793",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:connect-snippet": "node --experimental-strip-types scripts/connect-snippet-compile.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "wrangler:types": "wrangler types src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.72.0",
    "@sentry/react": "^10.72.0",
    "@splitch/contracts": "workspace:*",
    "@splitch/control-plane-sdk": "workspace:*",
    "@splitch/db": "workspace:*",
    "@splitch/observability": "workspace:*",
    "@splitch/sdk": "workspace:*",
    "@splitch/ui": "workspace:*",
    "@splitch/worker-runtime": "workspace:*",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.58",
    "@workos-inc/node": "^10.14.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.58.0",
    "@cloudflare/workers-types": "5.20260924.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "miniflare": "^4.20260730.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "4.137.0"
  }
}
