{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "splitch-evaluation-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SPLITCH_PLATFORM_TARGET": "local"
  },
  "kv_namespaces": [
    {
      "binding": "ASSIGNMENTS_KV",
      "id": "local-assignments-kv",
      "preview_id": "local-assignments-kv"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ASSIGNMENT_STORE_WRITER",
        "class_name": "AssignmentStoreDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["AssignmentStoreDurableObject"]
    }
  ],
  "env": {
    "shared-preview": {
      "name": "splitch-evaluation-api-shared-preview",
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "shared-preview"
      }
    },
    "production": {
      "name": "splitch-evaluation-api",
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "production"
      }
    }
  }
}
