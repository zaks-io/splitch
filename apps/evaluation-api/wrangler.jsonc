{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "splitch-evaluation-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["SENTRY_DSN", "AXIOM_TOKEN", "SPLITCH_EVENT_INGEST_TOKEN"]
  },
  "vars": {
    "SPLITCH_PLATFORM_TARGET": "local",
    "AXIOM_DATASET": "splitch-logs"
  },
  "services": [
    {
      "binding": "EVENT_INGEST",
      "service": "splitch-event-ingest-api"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ASSIGNMENTS_KV",
      "id": "local-assignments-kv",
      "preview_id": "local-assignments-kv"
    },
    {
      "binding": "CONFIG_STORE",
      "id": "local-config-store",
      "preview_id": "local-config-store"
    },
    {
      "binding": "CREDENTIAL_STORE",
      "id": "local-credential-store",
      "preview_id": "local-credential-store"
    },
    {
      "binding": "SESSION_STORE",
      "id": "local-session-store",
      "preview_id": "local-session-store"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ASSIGNMENT_STORE_WRITER",
        "class_name": "AssignmentStoreDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["AssignmentStoreDurableObject"]
    }
  ],
  "env": {
    "shared-preview": {
      "name": "splitch-evaluation-api-shared-preview",
      "workers_dev": false,
      "routes": [{ "pattern": "edge.preview.splitch.dev", "custom_domain": true }],
      "secrets": {
        "required": [
          "SENTRY_DSN",
          "AXIOM_TOKEN",
          "EVALUATION_PRIVACY_SALT",
          "SPLITCH_EVENT_INGEST_TOKEN"
        ]
      },
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "shared-preview",
        "AUTH_JWKS_URI": "https://auth.preview.splitch.dev/.well-known/jwks.json",
        "CONTROL_PLANE_ORIGIN": "https://api.preview.splitch.dev",
        "AXIOM_DATASET": "splitch-logs"
      },
      "kv_namespaces": [
        { "binding": "ASSIGNMENTS_KV", "id": "c3a126c4617443869c0afd1c2c69c70c" },
        { "binding": "CONFIG_STORE", "id": "70cc24e1592e4db4a5b37e8d0dd6d6af" },
        { "binding": "CREDENTIAL_STORE", "id": "05f656eb41b54063aa0d2d23a6082c5b" },
        { "binding": "SESSION_STORE", "id": "673d17e768eb45f5bfc5275fbd0e9320" }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ASSIGNMENT_STORE_WRITER",
            "class_name": "AssignmentStoreDurableObject"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_classes": ["AssignmentStoreDurableObject"]
        }
      ],
      "services": [
        {
          "binding": "EVENT_INGEST",
          "service": "splitch-event-ingest-api-shared-preview"
        }
      ]
    },
    "production": {
      "name": "splitch-evaluation-api",
      "workers_dev": false,
      "routes": [{ "pattern": "edge.splitch.dev", "custom_domain": true }],
      "secrets": {
        "required": [
          "SENTRY_DSN",
          "AXIOM_TOKEN",
          "EVALUATION_PRIVACY_SALT",
          "SPLITCH_EVENT_INGEST_TOKEN"
        ]
      },
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "production",
        "AUTH_JWKS_URI": "https://auth.splitch.dev/.well-known/jwks.json",
        "CONTROL_PLANE_ORIGIN": "https://api.splitch.dev",
        "AXIOM_DATASET": "splitch-logs"
      },
      "kv_namespaces": [
        { "binding": "ASSIGNMENTS_KV", "id": "cda6d6de2d974fef88e6e22d03551789" },
        { "binding": "CONFIG_STORE", "id": "b67d6cd1db424778a6dec24f64cbaa8d" },
        { "binding": "CREDENTIAL_STORE", "id": "2c0082cdd2f4426f8cfeb4d2bbd62277" },
        { "binding": "SESSION_STORE", "id": "bdfa1197123d4eef945c5a703d63a572" }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ASSIGNMENT_STORE_WRITER",
            "class_name": "AssignmentStoreDurableObject"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_classes": ["AssignmentStoreDurableObject"]
        }
      ],
      "services": [
        {
          "binding": "EVENT_INGEST",
          "service": "splitch-event-ingest-api"
        }
      ]
    }
  }
}
