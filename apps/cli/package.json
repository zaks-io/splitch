{
  "name": "@splitch/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "splitch": "./src/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "lint": "biome lint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@splitch/control-plane-sdk": "workspace:*",
    "@splitch/observability": "workspace:*",
    "tsx": "4.22.4"
  }
}
