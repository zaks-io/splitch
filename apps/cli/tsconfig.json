{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/test-fixtures.ts",
    "src/test-helpers.ts",
    "src/fetch-recording.ts",
    "src/quickstart-local-harness.ts",
    "src/dark-launch-experiment.ts",
    "src/dark-launch-http.ts",
    "src/dark-launch-scenario.ts",
    "src/dark-launch-negative-auth.ts"
  ]
}
