  winsorize                  optional  boolean | null
  winsorizePct               optional  number | null
  cuped                      optional  boolean | null
  cupedCoverageThresholdPct  optional  number | null
  idempotency_key            optional  string
  Example:
    {"appId":"app_1","name":"name","key":"key","kind":"binomial"}

