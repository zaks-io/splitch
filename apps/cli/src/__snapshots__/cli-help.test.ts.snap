    "experiments create": "Create an Experiment draft.

Usage:
  splitch experiments create [flags]

Flags:
  --app <app>              [type: string; default: SPLITCH_APP or config] App ID or slug.
  --env <environment>      [type: string; default: SPLITCH_ENV or config] Environment ID or slug.
  --name <name>            [type: string; default: none] Resource name.
  --key <key>              [type: string; default: none] Resource key.
  --body-json <json>       [type: JSON object; default: none] Request body fields; see Request body below.
  --idempotency-key <key>  [type: string; default: generated] Stable retry key for this mutation.
  --json                   [type: boolean; default: false] Write machine-readable JSON to stdout.
  -h, --help               [type: boolean; default: false] Show help and exit.

Request body (--body-json):
  appId               required  string
  environmentId       required  string
  name                required  string
  key                 required  string
  flagId              required  string
  targetingKey        required  string
  targetingKeyType    required  string
  description         optional  string
  hypothesis          optional  string
  confidenceLevel     optional; default 0.95  number
  metrics             required  { metricId: string }[]
  guardrailMetrics    optional; default []  { metricId: string }[]
  activationMetricId  optional  string | null
  conversionWindowMs  optional; default 0  number
  dimensions          optional; default []  string[]
  allocation          optional  Record<Variant name, number>
  salt                optional  string
  targetingRules      optional  { id: string; flagId: string; priority: number; conditions: { attribute: string; operator: string ("eq" | "neq" | "gt" | "lt" | "gte" | "lte" | "in" | "not_in" | "matches" | "not_matches"); value: boolean | string | number | unknown[] }[]; variantId: string; percentageRollout?: { percentage: number; salt: string } | null }[]
  segmentIds          optional  string[]
  idempotency_key     optional  string
  Example:
    {"appId":"app_1","environmentId":"environment_1","name":"name","key":"key","flagId":"flag_1","targetingKey":"userId","targetingKeyType":"user","metrics":[{"metricId":"metric_1"}]}

Example:
  splitch experiments create --body-json '{"appId":"app_1","environmentId":"environment_1","name":"name","key":"key","flagId":"flag_1","targetingKey":"userId","targetingKeyType":"user","metrics":[{"metricId":"metric_1"}]}' --json",
