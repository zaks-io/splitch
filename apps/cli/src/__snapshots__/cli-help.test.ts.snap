  conversionWindowMs  optional; default 0  number
  dimensions          optional; default []  string[]
  allocation          optional  Record<Variant name, number>
  salt                optional  string
  targetingRules      optional  { id: string; flagId: string; priority: number; conditions: { attribute: string; operator: string ("eq" | "neq" | "gt" | "lt" | "gte" | "lte" | "in" | "not_in" | "matches" | "not_matches"); value: boolean | string | number | (boolean | string | number)[] }[]; variantId: string; segmentId?: string; percentageRollout?: { percentage: number; salt?: string } | null }[]
  segmentIds          optional  string[]
  idempotency_key     optional  string
  Example:
    {"appId":"app_1","environmentId":"environment_1","name":"name","key":"key","flagId":"flag_1","targetingKey":"userId","targetingKeyType":"user","metrics":[{"metricId":"metric_1"}]}

