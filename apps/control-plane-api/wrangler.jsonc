{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "splitch-control-plane-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 8 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitch-d1",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_STORE",
      "id": "00000000000000000000000000000000"
    },
    {
      "binding": "CONFIG_STORE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CONFIG_STORE_WRITER", "class_name": "ConfigStoreDurableObject" }]
  },
  "migrations": [
    { "tag": "v1_config_store_writer", "new_sqlite_classes": ["ConfigStoreDurableObject"] }
  ],
  "vars": {
    "SPLITCH_PLATFORM_TARGET": "local"
  },
  "env": {
    "shared-preview": {
      "name": "splitch-control-plane-api-shared-preview",
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "shared-preview"
      }
    },
    "production": {
      "name": "splitch-control-plane-api",
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "production"
      }
    }
  }
}
