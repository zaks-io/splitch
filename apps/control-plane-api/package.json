{
  "name": "@splitch/control-plane-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "deploy": "node ../../scripts/deploy-worker-with-sentry.mjs",
    "deploy:dry-run": "node ../../scripts/deploy-worker-with-sentry.mjs --dry-run",
    "dev": "wrangler dev --local --port 8787 --test-scheduled --show-interactive-dev-session=false",
    "lint": "biome lint src",
    "test": "vitest run --passWithNoTests && vitest run --config vitest.config.workers.ts --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "wrangler:types": "wrangler types src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@splitch/contracts": "workspace:*",
    "@splitch/db": "workspace:*",
    "@splitch/observability": "workspace:*",
    "@splitch/worker-runtime": "workspace:*",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.17.0",
    "miniflare": "^4.20260617.0"
  }
}
