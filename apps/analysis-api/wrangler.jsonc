{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "splitch-analysis-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "traces": {
      "enabled": true,
      "destinations": ["axiom-traces"],
      "persist": false,
      "head_sampling_rate": 1
    },
    "logs": {
      "enabled": true,
      "destinations": ["axiom-logs"],
      "persist": false,
      "head_sampling_rate": 1
    }
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "secrets": {
    "required": ["SENTRY_DSN", "TINYBIRD_READ_TOKEN", "TINYBIRD_COPY_TOKEN"]
  },
  "vars": {
    "SPLITCH_PLATFORM_TARGET": "local",
    "TINYBIRD_API_URL": "https://api.us-west-2.aws.tinybird.co"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MCP_DELEGATION_REPLAY", "class_name": "McpDelegationReplayDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1_mcp_delegation_replay",
      "new_sqlite_classes": ["McpDelegationReplayDurableObject"]
    }
  ],
  "env": {
    "shared-preview": {
      "name": "splitch-analysis-api-shared-preview",
      "workers_dev": false,
      "observability": {
        "traces": {
          "enabled": true,
          "destinations": ["axiom-traces"],
          "persist": false,
          "head_sampling_rate": 1
        },
        "logs": {
          "enabled": true,
          "destinations": ["axiom-logs"],
          "persist": false,
          "head_sampling_rate": 1
        }
      },
      "triggers": {
        "crons": []
      },
      "secrets": {
        "required": ["SENTRY_DSN", "TINYBIRD_READ_TOKEN"]
      },
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "shared-preview",
        "TINYBIRD_API_URL": "https://api.us-west-2.aws.tinybird.co"
      },
      "durable_objects": {
        "bindings": [
          { "name": "MCP_DELEGATION_REPLAY", "class_name": "McpDelegationReplayDurableObject" }
        ]
      },
      "migrations": [
        {
          "tag": "v1_mcp_delegation_replay",
          "new_sqlite_classes": ["McpDelegationReplayDurableObject"]
        }
      ]
    },
    "production": {
      "name": "splitch-analysis-api",
      "workers_dev": false,
      "observability": {
        "traces": {
          "enabled": true,
          "destinations": ["axiom-traces"],
          "persist": false,
          "head_sampling_rate": 1
        },
        "logs": {
          "enabled": true,
          "destinations": ["axiom-logs"],
          "persist": false,
          "head_sampling_rate": 1
        }
      },
      "triggers": {
        "crons": ["0 * * * *"]
      },
      "secrets": {
        "required": ["SENTRY_DSN", "TINYBIRD_READ_TOKEN", "TINYBIRD_COPY_TOKEN"]
      },
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "production",
        "TINYBIRD_API_URL": "https://api.us-west-2.aws.tinybird.co"
      },
      "durable_objects": {
        "bindings": [
          { "name": "MCP_DELEGATION_REPLAY", "class_name": "McpDelegationReplayDurableObject" }
        ]
      },
      "migrations": [
        {
          "tag": "v1_mcp_delegation_replay",
          "new_sqlite_classes": ["McpDelegationReplayDurableObject"]
        }
      ]
    }
  }
}
