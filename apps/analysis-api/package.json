{
  "name": "@splitch/analysis-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "dev": "wrangler dev --local --port 8790 --test-scheduled --show-interactive-dev-session=false",
    "lint": "biome lint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "wrangler:types": "wrangler types src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@splitch/contracts": "workspace:*",
    "@splitch/stats": "workspace:*",
    "@splitch/observability": "workspace:*",
    "@splitch/worker-runtime": "workspace:*",
    "hono": "^4.12.27"
  }
}
