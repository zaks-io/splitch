{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "splitch-event-ingest-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["SPLITCH_EVENT_INGEST_TOKEN", "TINYBIRD_INGEST_TOKEN"]
  },
  "vars": {
    "SPLITCH_PLATFORM_TARGET": "local",
    "TINYBIRD_API_URL": "https://api.us-west-2.aws.tinybird.co"
  },
  "kv_namespaces": [
    {
      "binding": "CONFIG_STORE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "env": {
    "shared-preview": {
      "name": "splitch-event-ingest-api-shared-preview",
      "workers_dev": false,
      "routes": [{ "pattern": "ingest.preview.splitch.dev", "custom_domain": true }],
      "secrets": {
        "required": ["SPLITCH_EVENT_INGEST_TOKEN", "TINYBIRD_INGEST_TOKEN"]
      },
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "shared-preview",
        "TINYBIRD_API_URL": "https://api.us-west-2.aws.tinybird.co"
      },
      "kv_namespaces": [{ "binding": "CONFIG_STORE", "id": "70cc24e1592e4db4a5b37e8d0dd6d6af" }]
    },
    "production": {
      "name": "splitch-event-ingest-api",
      "workers_dev": false,
      "routes": [{ "pattern": "ingest.splitch.dev", "custom_domain": true }],
      "secrets": {
        "required": ["SPLITCH_EVENT_INGEST_TOKEN", "TINYBIRD_INGEST_TOKEN"]
      },
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "production",
        "TINYBIRD_API_URL": "https://api.us-west-2.aws.tinybird.co"
      },
      "kv_namespaces": [{ "binding": "CONFIG_STORE", "id": "b67d6cd1db424778a6dec24f64cbaa8d" }]
    }
  }
}
