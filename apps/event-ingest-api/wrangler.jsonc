{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "splitch-event-ingest-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "traces": {
      "enabled": true,
      "destinations": ["axiom-traces"],
      "persist": false,
      "head_sampling_rate": 1
    },
    "logs": {
      "enabled": true,
      "destinations": ["axiom-logs"],
      "persist": false,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": ["SENTRY_DSN", "SPLITCH_EVENT_INGEST_TOKEN", "TINYBIRD_INGEST_TOKEN"]
  },
  "vars": {
    "SPLITCH_PLATFORM_TARGET": "local",
    "TINYBIRD_API_URL": "https://api.us-west-2.aws.tinybird.co"
  },
  "kv_namespaces": [
    {
      "binding": "CONFIG_STORE",
      "id": "00000000000000000000000000000000"
    },
    {
      "binding": "CREDENTIAL_STORE",
      "id": "local-credential-store",
      "preview_id": "local-credential-store"
    }
  ],
  "queues": {
    "producers": [{ "binding": "METRIC_EVENTS_QUEUE", "queue": "splitch-metric-events-local" }],
    "consumers": [
      {
        "queue": "splitch-metric-events-local",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 7
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EVALUATION_USAGE_REPLAY_WINDOW",
        "class_name": "EvaluationUsageReplayWindowDurableObject"
      },
      {
        "name": "EVALUATION_COMMIT_OUTBOX",
        "class_name": "EvaluationCommitOutboxDurableObject"
      },
      {
        "name": "METRIC_EVENT_OUTBOX",
        "class_name": "MetricEventOutboxDurableObject"
      },
      {
        "name": "METRIC_EVENT_RATE_LIMIT",
        "class_name": "MetricEventRateLimitDurableObject"
      },
      {
        "name": "INGEST_ADMISSION_GATE",
        "class_name": "IngestAdmissionGateDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1_evaluation_usage_replay_window",
      "new_sqlite_classes": ["EvaluationUsageReplayWindowDurableObject"]
    },
    {
      "tag": "v2_evaluation_commit_outbox",
      "new_sqlite_classes": ["EvaluationCommitOutboxDurableObject"]
    },
    {
      "tag": "v3_metric_event_ingest",
      "new_sqlite_classes": ["MetricEventOutboxDurableObject", "MetricEventRateLimitDurableObject"]
    },
    {
      "tag": "v4_ingest_admission_gate",
      "new_sqlite_classes": ["IngestAdmissionGateDurableObject"]
    }
  ],
  "env": {
    "shared-preview": {
      "name": "splitch-event-ingest-api-shared-preview",
      "workers_dev": false,
      "observability": {
        "traces": {
          "enabled": true,
          "destinations": ["axiom-traces"],
          "persist": false,
          "head_sampling_rate": 1
        },
        "logs": {
          "enabled": true,
          "destinations": ["axiom-logs"],
          "persist": false,
          "head_sampling_rate": 1
        }
      },
      "routes": [{ "pattern": "ingest.preview.splitch.dev", "custom_domain": true }],
      "secrets": {
        "required": [
          "SENTRY_DSN",
          "SPLITCH_EVENT_INGEST_TOKEN",
          "TINYBIRD_INGEST_TOKEN",
          "EVALUATION_PRIVACY_SALT"
        ]
      },
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "shared-preview",
        "TINYBIRD_API_URL": "https://api.us-west-2.aws.tinybird.co"
      },
      "kv_namespaces": [
        { "binding": "CONFIG_STORE", "id": "70cc24e1592e4db4a5b37e8d0dd6d6af" },
        { "binding": "CREDENTIAL_STORE", "id": "05f656eb41b54063aa0d2d23a6082c5b" }
      ],
      "queues": {
        "producers": [
          { "binding": "METRIC_EVENTS_QUEUE", "queue": "splitch-metric-events-shared-preview" }
        ],
        "consumers": [
          {
            "queue": "splitch-metric-events-shared-preview",
            "max_batch_size": 100,
            "max_batch_timeout": 5,
            "max_retries": 7
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "EVALUATION_USAGE_REPLAY_WINDOW",
            "class_name": "EvaluationUsageReplayWindowDurableObject"
          },
          {
            "name": "EVALUATION_COMMIT_OUTBOX",
            "class_name": "EvaluationCommitOutboxDurableObject"
          },
          {
            "name": "METRIC_EVENT_OUTBOX",
            "class_name": "MetricEventOutboxDurableObject"
          },
          {
            "name": "METRIC_EVENT_RATE_LIMIT",
            "class_name": "MetricEventRateLimitDurableObject"
          },
          {
            "name": "INGEST_ADMISSION_GATE",
            "class_name": "IngestAdmissionGateDurableObject"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1_evaluation_usage_replay_window",
          "new_sqlite_classes": ["EvaluationUsageReplayWindowDurableObject"]
        },
        {
          "tag": "v2_evaluation_commit_outbox",
          "new_sqlite_classes": ["EvaluationCommitOutboxDurableObject"]
        },
        {
          "tag": "v3_metric_event_ingest",
          "new_sqlite_classes": [
            "MetricEventOutboxDurableObject",
            "MetricEventRateLimitDurableObject"
          ]
        },
        {
          "tag": "v4_ingest_admission_gate",
          "new_sqlite_classes": ["IngestAdmissionGateDurableObject"]
        }
      ]
    },
    "production": {
      "name": "splitch-event-ingest-api",
      "workers_dev": false,
      "observability": {
        "traces": {
          "enabled": true,
          "destinations": ["axiom-traces"],
          "persist": false,
          "head_sampling_rate": 1
        },
        "logs": {
          "enabled": true,
          "destinations": ["axiom-logs"],
          "persist": false,
          "head_sampling_rate": 1
        }
      },
      "routes": [{ "pattern": "ingest.splitch.dev", "custom_domain": true }],
      "secrets": {
        "required": [
          "SENTRY_DSN",
          "SPLITCH_EVENT_INGEST_TOKEN",
          "TINYBIRD_INGEST_TOKEN",
          "EVALUATION_PRIVACY_SALT"
        ]
      },
      "vars": {
        "SPLITCH_PLATFORM_TARGET": "production",
        "TINYBIRD_API_URL": "https://api.us-west-2.aws.tinybird.co"
      },
      "kv_namespaces": [
        { "binding": "CONFIG_STORE", "id": "b67d6cd1db424778a6dec24f64cbaa8d" },
        { "binding": "CREDENTIAL_STORE", "id": "2c0082cdd2f4426f8cfeb4d2bbd62277" }
      ],
      "queues": {
        "producers": [{ "binding": "METRIC_EVENTS_QUEUE", "queue": "splitch-metric-events" }],
        "consumers": [
          {
            "queue": "splitch-metric-events",
            "max_batch_size": 100,
            "max_batch_timeout": 5,
            "max_retries": 7
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "EVALUATION_USAGE_REPLAY_WINDOW",
            "class_name": "EvaluationUsageReplayWindowDurableObject"
          },
          {
            "name": "EVALUATION_COMMIT_OUTBOX",
            "class_name": "EvaluationCommitOutboxDurableObject"
          },
          {
            "name": "METRIC_EVENT_OUTBOX",
            "class_name": "MetricEventOutboxDurableObject"
          },
          {
            "name": "METRIC_EVENT_RATE_LIMIT",
            "class_name": "MetricEventRateLimitDurableObject"
          },
          {
            "name": "INGEST_ADMISSION_GATE",
            "class_name": "IngestAdmissionGateDurableObject"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1_evaluation_usage_replay_window",
          "new_sqlite_classes": ["EvaluationUsageReplayWindowDurableObject"]
        },
        {
          "tag": "v2_evaluation_commit_outbox",
          "new_sqlite_classes": ["EvaluationCommitOutboxDurableObject"]
        },
        {
          "tag": "v3_metric_event_ingest",
          "new_sqlite_classes": [
            "MetricEventOutboxDurableObject",
            "MetricEventRateLimitDurableObject"
          ]
        },
        {
          "tag": "v4_ingest_admission_gate",
          "new_sqlite_classes": ["IngestAdmissionGateDurableObject"]
        }
      ]
    }
  }
}
