{
  "name": "@splitch/stats",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "lint": "biome lint src",
    "stats:audit": "vitest run --config vitest.audit.config.ts",
    "stats:golden": "vitest run --config vitest.golden.config.ts",
    "stats:property": "vitest run --config vitest.property.config.ts",
    "stats:simulation": "node scripts/run-stats-simulation.mjs",
    "stats:simulation:vitest": "vitest run --config vitest.simulation.config.ts",
    "stats:unit": "vitest run --config vitest.config.ts",
    "test": "pnpm stats:unit",
    "test:mutation": "stryker run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.audit.json"
  },
  "dependencies": {
    "@splitch/contracts": "workspace:*"
  }
}
