{
  "name": "@splitch/observability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "lint": "biome lint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@axiomhq/js": "^1.6.1",
    "@sentry/cloudflare": "^9.47.0",
    "@sentry/node": "^9.47.0",
    "@splitch/contracts": "workspace:*",
    "@splitch/privacy": "workspace:*",
    "@splitch/worker-runtime": "workspace:*"
  }
}
