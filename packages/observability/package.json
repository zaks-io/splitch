{
  "name": "@splitch/observability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./emitter": {
      "types": "./src/emitter.ts",
      "default": "./src/emitter.ts"
    },
    "./worker": {
      "types": "./src/worker.ts",
      "default": "./src/worker.ts"
    },
    "./mcp-spans": {
      "types": "./src/mcp-spans.ts",
      "default": "./src/mcp-spans.ts"
    },
    "./performance-spans": {
      "types": "./src/performance-spans.ts",
      "default": "./src/performance-spans.ts"
    },
    "./sentry-module": {
      "types": "./src/sentry-module.ts",
      "default": "./src/sentry-module.ts"
    },
    "./cloudflare-web-analytics": {
      "types": "./src/cloudflare-web-analytics.ts",
      "default": "./src/cloudflare-web-analytics.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "lint": "biome lint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.68.0",
    "@sentry/node": "^10.68.0",
    "@splitch/contracts": "workspace:*",
    "@splitch/privacy": "workspace:*",
    "@splitch/worker-runtime": "workspace:*",
    "typescript": "^7.0.2"
  }
}
