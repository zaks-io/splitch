    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "miniflare": "^4.20260617.0"
  }
