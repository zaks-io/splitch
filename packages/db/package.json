{
  "name": "@splitch/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test-d1": {
      "types": "./src/repo/test-d1.ts",
      "default": "./src/repo/test-d1.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "db:generate": "drizzle-kit generate",
    "lint": "biome lint src",
    "migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "migrate:shared-preview": "wrangler d1 migrations apply DB --remote --env shared-preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "miniflare": "^4.20260701.0"
  }
}
