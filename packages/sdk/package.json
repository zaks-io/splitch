{
  "name": "@splitch/sdk",
  "version": "0.2.2",
  "description": "Public JavaScript/TypeScript SDK for splitch data-plane evaluation",
  "license": "Apache-2.0",
  "homepage": "https://splitch.dev",
  "keywords": [
    "feature-flags",
    "experiments",
    "ab-testing",
    "openfeature",
    "edge",
    "splitch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaks-io/splitch.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "generate": "npx tsup --config tsup.contract-surface.config.ts",
    "build": "pnpm run generate && npx tsup --config tsup.config.ts && node scripts/write-build-stamp.mjs",
    "clean": "rm -rf dist coverage src/generated/contract-surface.js src/generated/contract-surface.d.ts",
    "lint": "biome lint src scripts",
    "test": "vitest run --passWithNoTests && node --test scripts/size-check.test.mjs",
    "test:browser-smoke": "node scripts/browser-smoke.mjs",
    "test:consumer-smoke": "node scripts/consumer-smoke.mjs",
    "test:mutation": "stryker run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.contract-assignability.json --noEmit",
    "size:check": "node scripts/size-check.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "pack:dry-run": "node scripts/pack-dry-run.mjs",
    "prepack": "node scripts/prepack-guard.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
