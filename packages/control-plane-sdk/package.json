{
  "name": "@splitch/control-plane-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./mcp-operation-adapter": {
      "types": "./src/mcp-operation-adapter.ts",
      "default": "./src/mcp-operation-adapter.ts"
    },
    "./idempotency-header": {
      "types": "./src/idempotency-header.ts",
      "default": "./src/idempotency-header.ts"
    },
    "./control-panel-identity": {
      "types": "./src/control-panel-identity.ts",
      "default": "./src/control-panel-identity.ts"
    },
    "./panel-experiments": {
      "types": "./src/panel-experiments.ts",
      "default": "./src/panel-experiments.ts"
    },
    "./panel-metrics": {
      "types": "./src/panel-metrics.ts",
      "default": "./src/panel-metrics.ts"
    },
    "./panel-org-members": {
      "types": "./src/panel-org-members.ts",
      "default": "./src/panel-org-members.ts"
    },
    "./panel-segments": {
      "types": "./src/panel-segments.ts",
      "default": "./src/panel-segments.ts"
    },
    "./panel-overview": {
      "types": "./src/panel-overview.ts",
      "default": "./src/panel-overview.ts"
    },
    "./panel-settings": {
      "types": "./src/panel-settings.ts",
      "default": "./src/panel-settings.ts"
    },
    "./panel-usage": {
      "types": "./src/panel-usage.ts",
      "default": "./src/panel-usage.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "lint": "biome lint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@splitch/contracts": "workspace:*",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  }
}
