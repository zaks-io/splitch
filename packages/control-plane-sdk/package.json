{
  "name": "@splitch/control-plane-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./mcp-operation-adapter": {
      "types": "./src/mcp-operation-adapter.ts",
      "default": "./src/mcp-operation-adapter.ts"
    },
    "./panel-experiments": {
      "types": "./src/panel-experiments.ts",
      "default": "./src/panel-experiments.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "lint": "biome lint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@splitch/contracts": "workspace:*",
    "hono": "^4.12.27"
  }
}
