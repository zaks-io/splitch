{
  "name": "@splitch/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./route-types": {
      "types": "./src/route-types.ts",
      "default": "./src/route-types.ts"
    },
    "./client-app": {
      "types": "./src/control-plane-client-app.ts",
      "default": "./src/control-plane-client-app.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "lint": "biome lint src",
    "test": "vitest run --passWithNoTests",
    "test:mutation": "stryker run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.1",
    "hono": "^4.13.4",
    "zod": "^4.4.3"
  }
}
