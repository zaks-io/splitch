DESCRIPTION >
    Materialize one argMin state per Metric Event retry identity.

NODE metric_event_retry_state
SQL >
    SELECT
        app_id,
        environment_id,
        toDate(server_received_at) AS event_date,
        event_definition_id,
        id_type,
        server_received_at,
        targeting_key_hash,
        dedup_key,
        argMinState(
            tuple(event_id, event_definition_version_id, event_name, fields, dimensions, server_received_at, ingest_ts),
            ingest_ts
        ) AS canonical_state
    FROM metric_events
    GROUP BY
        app_id,
        environment_id,
        event_date,
        event_definition_id,
        id_type,
        server_received_at,
        targeting_key_hash,
        dedup_key

TYPE MATERIALIZED
DATASOURCE deduped_metric_events_state
