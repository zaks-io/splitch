DESCRIPTION >
    Record the durable first real Exposure for each App and Environment.
    Deployment population backfills every retained raw Exposure on first deploy.

NODE environment_first_exposure_state
SQL >
    SELECT
        app_id,
        environment_id,
        splitByChar(':', targeting_key_hash)[1] AS targeting_key_version,
        minState(exposure_at) AS first_exposure_state
    FROM raw_events
    LEFT JOIN app_identity_generation_tombstones AS generation_tombstones
        ON generation_tombstones.app_id = raw_events.app_id
        AND generation_tombstones.targeting_key_version = splitByChar(':', raw_events.targeting_key_hash)[1]
    WHERE type = 'exposure'
        AND generation_tombstones.app_id = ''
    GROUP BY app_id, environment_id, targeting_key_version

TYPE MATERIALIZED
DATASOURCE environment_exposure_status_state
