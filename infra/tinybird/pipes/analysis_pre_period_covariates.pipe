DESCRIPTION >
    Returns pre-period covariates for one Binomial, Count, or Revenue Metric.

NODE scoped_pre_period_exposures
SQL >
    %
    {% if not defined(app_id) %} {{ error('app_id is required') }}{% end %}
    {% if not defined(environment_id) %} {{ error('environment_id is required') }}{% end %}
    {% if not defined(experiment_id) %} {{ error('experiment_id is required') }}{% end %}
    {% if not defined(run_id) %} {{ error('run_id is required') }}{% end %}
    SELECT app_id, environment_id, id_type, targeting_key_hash, first_exposure_ts
    FROM serve_deduped_exposures
    WHERE
        app_id = {{ String(app_id) }}
        AND environment_id = {{ String(environment_id) }}
        AND experiment_id = {{ String(experiment_id) }}
        AND run_id = {{ String(run_id) }}

NODE scoped_pre_period_events
SQL >
    %
    {% if not defined(app_id) %} {{ error('app_id is required') }}{% end %}
    {% if not defined(environment_id) %} {{ error('environment_id is required') }}{% end %}
    {% if not defined(event_definition_id) %} {{ error('event_definition_id is required') }}{% end %}
    {% if not defined(metric_type) %} {{ error('metric_type is required') }}{% end %}
    {% if metric_type not in ['binomial', 'count', 'revenue'] %}
        {{ error('metric_type must be binomial, count, or revenue') }}
    {% end %}
    {% if metric_type != 'binomial' and not defined(event_field_name) %}
        {{ error('event_field_name is required for Count and Revenue') }}
    {% end %}
    {% if not defined(from_ts) %} {{ error('from_ts is required') }}{% end %}
    {% if not defined(to_ts) %} {{ error('to_ts is required') }}{% end %}
    SELECT
        app_id,
        environment_id,
        id_type,
        targeting_key_hash,
        accepted_at,
        {% if metric_type == 'binomial' %} toFloat64(1) AS event_value
        {% else %} toFloat64(JSONExtractRaw(fields, {{ String(event_field_name) }})) AS event_value
        {% end %}
    FROM serve_deduped_metric_events
    WHERE
        app_id = {{ String(app_id) }}
        AND environment_id = {{ String(environment_id) }}
        AND event_definition_id = {{ String(event_definition_id) }}
        AND accepted_at >= {{ DateTime64(from_ts) }}
        AND accepted_at < {{ DateTime64(to_ts) }}
        {% if metric_type != 'binomial' %}
            AND JSONHas(fields, {{ String(event_field_name) }})
        {% end %}

NODE binomial_pre_period_values
SQL >
    %
    {% if not defined(app_id) %} {{ error('app_id is required') }}{% end %}
    {% if not defined(environment_id) %} {{ error('environment_id is required') }}{% end %}
    {% if not defined(metric_id) %} {{ error('metric_id is required') }}{% end %}
    {% if not defined(metric_type) %} {{ error('metric_type is required') }}{% end %}
    {% if not defined(lookback_ms) %} {{ error('lookback_ms is required') }}{% end %}
    SELECT
        exposures.targeting_key_hash AS targeting_key_hash,
        {{ String(metric_id) }} AS metric_id,
        {% if metric_type == 'binomial' %}
            toFloat64(countIf(events.event_value > 0) > 0) AS pre_period_value,
        {% else %} sum(events.event_value) AS pre_period_value,
        {% end %}
        'pre_period' AS covariate_source
    FROM scoped_pre_period_exposures AS exposures
    INNER JOIN
        scoped_pre_period_events AS events
        ON events.app_id = exposures.app_id
        AND events.environment_id = exposures.environment_id
        AND events.app_id = {{ String(app_id) }}
        AND events.environment_id = {{ String(environment_id) }}
        AND events.id_type = exposures.id_type
        AND events.targeting_key_hash = exposures.targeting_key_hash
        AND events.accepted_at
        >= subtractMilliseconds(exposures.first_exposure_ts, {{ UInt64(lookback_ms) }})
        AND events.accepted_at < exposures.first_exposure_ts
    WHERE
        exposures.app_id = {{ String(app_id) }}
        AND exposures.environment_id = {{ String(environment_id) }}
    GROUP BY exposures.targeting_key_hash
    ORDER BY targeting_key_hash

TYPE ENDPOINT
