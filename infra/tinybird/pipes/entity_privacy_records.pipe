DESCRIPTION Tenant-scoped raw and derived Tinybird records for one Entity identity family.

NODE entity_records_union
SQL >
    %
    {% if not defined(app_id) %}
    {{error('app_id is required')}}
    {% end %}
    {% if not defined(id_type) %}
    {{error('id_type is required')}}
    {% end %}
    {% if not defined(entity_family_hash) %}
    {{error('entity_family_hash is required')}}
    {% end %}
    SELECT
        'raw_events' AS store,
        dedup_key AS record_id,
        targeting_key_hash,
        entity_family_hash,
        server_received_at,
        toJSONString(map(
            'environment_id', environment_id,
            'experiment_id', experiment_id,
            'run_id', run_id,
            'type', type,
            'event_id', event_id,
            'variant', ifNull(variant, '')
        )) AS record
    FROM raw_events
    WHERE app_id = {{String(app_id)}}
        AND id_type = {{String(id_type)}}
        AND entity_family_hash = {{String(entity_family_hash)}}
    UNION ALL
    SELECT
        'metric_events' AS store,
        dedup_key AS record_id,
        targeting_key_hash,
        entity_family_hash,
        server_received_at,
        toJSONString(map(
            'environment_id', environment_id,
            'event_definition_id', event_definition_id,
            'event_definition_version_id', event_definition_version_id,
            'event_name', event_name,
            'fields', fields,
            'dimensions', dimensions
        )) AS record
    FROM metric_events
    WHERE app_id = {{String(app_id)}}
        AND id_type = {{String(id_type)}}
        AND entity_family_hash = {{String(entity_family_hash)}}
    UNION ALL
    SELECT
        'deduped_exposures' AS store,
        concat(environment_id, ':', experiment_id, ':', run_id, ':', targeting_key_hash) AS record_id,
        targeting_key_hash,
        entity_family_hash,
        first_exposure_ts AS server_received_at,
        toJSONString(map(
            'environment_id', environment_id,
            'experiment_id', experiment_id,
            'run_id', run_id,
            'variant', variant
        )) AS record
    FROM deduped_exposures
    WHERE app_id = {{String(app_id)}}
        AND id_type = {{String(id_type)}}
        AND entity_family_hash = {{String(entity_family_hash)}}
    UNION ALL
    SELECT
        'deduped_metric_events_state' AS store,
        dedup_key AS record_id,
        targeting_key_hash,
        entity_family_hash,
        server_received_at,
        toJSONString(map(
            'environment_id', environment_id,
            'event_definition_id', event_definition_id
        )) AS record
    FROM deduped_metric_events_state
    WHERE app_id = {{String(app_id)}}
        AND id_type = {{String(id_type)}}
        AND entity_family_hash = {{String(entity_family_hash)}}

NODE entity_records
SQL >
    SELECT *
    FROM entity_records_union
    ORDER BY store, record_id

TYPE ENDPOINT
