DESCRIPTION Tenant-scoped raw and derived Tinybird records for one Entity identity family.

NODE entity_deletion_cutoffs
SQL >
    %
    SELECT
        app_id,
        id_type,
        entity_family_hash,
        max(delete_before_ts) AS delete_before_ts
    FROM entity_deletions
    WHERE app_id = {{String(app_id)}}
        AND id_type = {{String(id_type)}}
        AND entity_family_hash = {{String(entity_family_hash)}}
    GROUP BY app_id, id_type, entity_family_hash

NODE entity_records_union
SQL >
    %
    {% if not defined(app_id) %}
    {{error('app_id is required')}}
    {% end %}
    {% if not defined(id_type) %}
    {{error('id_type is required')}}
    {% end %}
    {% if not defined(entity_family_hash) %}
    {{error('entity_family_hash is required')}}
    {% end %}
    SELECT
        'raw_events' AS store,
        dedup_key AS record_id,
        events.targeting_key_hash,
        events.entity_family_hash AS entity_family_hash,
        events.server_received_at,
        toJSONString(map(
            'environment_id', environment_id,
            'experiment_id', experiment_id,
            'run_id', run_id,
            'type', type,
            'event_id', event_id,
            'variant', ifNull(variant, '')
        )) AS record
    FROM raw_events AS events
    LEFT JOIN app_identity_generation_tombstones AS generation_tombstones
        ON generation_tombstones.app_id = events.app_id
        AND generation_tombstones.targeting_key_version = splitByChar(':', events.targeting_key_hash)[1]
    LEFT JOIN entity_deletion_cutoffs AS deletions
        ON deletions.app_id = events.app_id
        AND deletions.id_type = events.id_type
        AND deletions.entity_family_hash = events.entity_family_hash
    WHERE events.app_id = {{String(app_id)}}
        AND events.id_type = {{String(id_type)}}
        AND events.entity_family_hash = {{String(entity_family_hash)}}
        AND generation_tombstones.app_id = ''
        AND (deletions.delete_before_ts IS NULL OR events.server_received_at > deletions.delete_before_ts)
    UNION ALL
    SELECT
        'metric_events' AS store,
        dedup_key AS record_id,
        events.targeting_key_hash,
        events.entity_family_hash AS entity_family_hash,
        events.server_received_at,
        toJSONString(map(
            'environment_id', environment_id,
            'event_definition_id', event_definition_id,
            'event_definition_version_id', event_definition_version_id,
            'event_name', event_name,
            'fields', fields,
            'dimensions', dimensions
        )) AS record
    FROM metric_events AS events
    LEFT JOIN app_identity_generation_tombstones AS generation_tombstones
        ON generation_tombstones.app_id = events.app_id
        AND generation_tombstones.targeting_key_version = splitByChar(':', events.targeting_key_hash)[1]
    LEFT JOIN entity_deletion_cutoffs AS deletions
        ON deletions.app_id = events.app_id
        AND deletions.id_type = events.id_type
        AND deletions.entity_family_hash = events.entity_family_hash
    WHERE events.app_id = {{String(app_id)}}
        AND events.id_type = {{String(id_type)}}
        AND events.entity_family_hash = {{String(entity_family_hash)}}
        AND generation_tombstones.app_id = ''
        AND (deletions.delete_before_ts IS NULL OR events.server_received_at > deletions.delete_before_ts)
    UNION ALL
    SELECT
        'deduped_exposures' AS store,
        concat(environment_id, ':', experiment_id, ':', run_id, ':', targeting_key_hash) AS record_id,
        exposures.targeting_key_hash,
        exposures.entity_family_hash AS entity_family_hash,
        exposures.first_exposure_ts AS server_received_at,
        toJSONString(map(
            'environment_id', environment_id,
            'experiment_id', experiment_id,
            'run_id', run_id,
            'variant', variant
        )) AS record
    FROM deduped_exposures AS exposures
    LEFT JOIN app_identity_generation_tombstones AS generation_tombstones
        ON generation_tombstones.app_id = exposures.app_id
        AND generation_tombstones.targeting_key_version = splitByChar(':', exposures.targeting_key_hash)[1]
    LEFT JOIN entity_deletion_cutoffs AS deletions
        ON deletions.app_id = exposures.app_id
        AND deletions.id_type = exposures.id_type
        AND deletions.entity_family_hash = exposures.entity_family_hash
    WHERE exposures.app_id = {{String(app_id)}}
        AND exposures.id_type = {{String(id_type)}}
        AND exposures.entity_family_hash = {{String(entity_family_hash)}}
        AND generation_tombstones.app_id = ''
        AND (deletions.delete_before_ts IS NULL OR exposures.first_exposure_ts > deletions.delete_before_ts)
    UNION ALL
    SELECT
        'deduped_metric_events_state' AS store,
        dedup_key AS record_id,
        events.targeting_key_hash,
        events.entity_family_hash AS entity_family_hash,
        events.server_received_at,
        toJSONString(map(
            'environment_id', environment_id,
            'event_definition_id', event_definition_id
        )) AS record
    FROM deduped_metric_events_state AS events
    LEFT JOIN app_identity_generation_tombstones AS generation_tombstones
        ON generation_tombstones.app_id = events.app_id
        AND generation_tombstones.targeting_key_version = splitByChar(':', events.targeting_key_hash)[1]
    LEFT JOIN entity_deletion_cutoffs AS deletions
        ON deletions.app_id = events.app_id
        AND deletions.id_type = events.id_type
        AND deletions.entity_family_hash = events.entity_family_hash
    WHERE events.app_id = {{String(app_id)}}
        AND events.id_type = {{String(id_type)}}
        AND events.entity_family_hash = {{String(entity_family_hash)}}
        AND generation_tombstones.app_id = ''
        AND (deletions.delete_before_ts IS NULL OR events.server_received_at > deletions.delete_before_ts)

NODE entity_records
SQL >
    %
    {% if not defined(limit) %}
    {{error('limit is required')}}
    {% end %}
    {% if defined(after_store) and (not defined(after_record_id) or not defined(after_server_received_at) or not defined(after_targeting_key_hash) or not defined(after_record_hash)) %}
    {{error('every Entity privacy cursor field is required')}}
    {% end %}
    {% if not defined(after_store) and (defined(after_record_id) or defined(after_server_received_at) or defined(after_targeting_key_hash) or defined(after_record_hash)) %}
    {{error('after_store is required with an Entity privacy cursor')}}
    {% end %}
    WITH page_candidates AS (
        SELECT DISTINCT
            store,
            record_id,
            targeting_key_hash,
            entity_family_hash,
            server_received_at,
            record,
            lower(hex(SHA256(record))) AS record_hash
        FROM entity_records_union
        WHERE throwIf(
            {{Int32(limit)}} < 1 OR {{Int32(limit)}} > 100,
            'limit must be an integer in 1..100'
        ) = 0
            {% if defined(after_store) %}
            AND (store, record_id, server_received_at, targeting_key_hash, record_hash) > (
                {{String(after_store)}},
                {{String(after_record_id)}},
                {{DateTime64(after_server_received_at, 3)}},
                {{String(after_targeting_key_hash)}},
                {{String(after_record_hash)}}
            )
            {% end %}
        ORDER BY store, record_id, server_received_at, targeting_key_hash, record_hash
        LIMIT {{Int32(limit)}} + 1
    )
    SELECT
        store,
        record_id,
        targeting_key_hash,
        entity_family_hash,
        server_received_at,
        record,
        record_hash,
        count() OVER () > {{Int32(limit)}} AS has_more
    FROM page_candidates
    ORDER BY store, record_id, server_received_at, targeting_key_hash, record_hash
    LIMIT {{Int32(limit)}}

TYPE ENDPOINT
