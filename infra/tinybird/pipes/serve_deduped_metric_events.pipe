DESCRIPTION >
    Tenant- and time-bounded logical Metric Events with physical retries collapsed.

NODE entity_deletion_cutoffs
SQL >
    %
    SELECT
        app_id,
        id_type,
        entity_family_hash,
        max(delete_before_ts) AS delete_before_ts
    FROM entity_deletions
    WHERE app_id = {{String(app_id)}}
    GROUP BY app_id, id_type, entity_family_hash

NODE deduped_metric_events
SQL >
    %
    {% if not defined(app_id) %}
    {{error('app_id is required')}}
    {% end %}
    {% if not defined(environment_id) %}
    {{error('environment_id is required')}}
    {% end %}
    {% if not defined(from_ts) %}
    {{error('from_ts is required')}}
    {% end %}
    {% if not defined(to_ts) %}
    {{error('to_ts is required')}}
    {% end %}
    SELECT
        events.app_id AS app_id,
        events.environment_id AS environment_id,
        events.event_definition_id AS event_definition_id,
        events.id_type AS id_type,
        events.targeting_key_hash AS targeting_key_hash,
        events.entity_family_hash AS entity_family_hash,
        events.dedup_key AS dedup_key,
        tupleElement(argMinMerge(events.canonical_state), 1) AS event_id,
        tupleElement(argMinMerge(events.canonical_state), 2) AS event_definition_version_id,
        tupleElement(argMinMerge(events.canonical_state), 3) AS event_name,
        tupleElement(argMinMerge(events.canonical_state), 4) AS fields,
        tupleElement(argMinMerge(events.canonical_state), 5) AS dimensions,
        tupleElement(argMinMerge(events.canonical_state), 6) AS accepted_at
    FROM deduped_metric_events_state AS events
    LEFT JOIN entity_deletion_cutoffs AS deletions
        ON deletions.app_id = events.app_id
        AND deletions.id_type = events.id_type
        AND deletions.entity_family_hash = events.entity_family_hash
    LEFT JOIN app_identity_generation_tombstones AS generation_tombstones
        ON generation_tombstones.app_id = events.app_id
        AND generation_tombstones.targeting_key_version = splitByChar(':', events.targeting_key_hash)[1]
    WHERE events.app_id = {{String(app_id)}}
        AND events.environment_id = {{String(environment_id)}}
        AND events.event_date >= toDate({{DateTime64(from_ts)}})
        AND events.event_date <= toDate({{DateTime64(to_ts)}})
        AND events.server_received_at >= {{DateTime64(from_ts)}}
        AND events.server_received_at < {{DateTime64(to_ts)}}
        AND generation_tombstones.app_id = ''
        AND (deletions.delete_before_ts IS NULL OR events.server_received_at > deletions.delete_before_ts)
    GROUP BY events.app_id, events.environment_id, events.event_definition_id, events.id_type, events.targeting_key_hash, events.entity_family_hash, events.dedup_key

TYPE ENDPOINT
