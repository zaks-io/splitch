DESCRIPTION Refreshes the deduped first-touch exposure snapshot from the raw append-only log.

NODE deduped_first_touch
SQL >
    %
    {% if not defined(copy_watermark_ts) %}
    {{error('copy_watermark_ts is required')}}
    {% end %}
    {{max_threads(1)}}
    WITH {{DateTime64(copy_watermark_ts)}} AS copy_watermark
    SELECT
        app_id,
        environment_id,
        experiment_id,
        run_id,
        id_type,
        argMin(targeting_key_hash, exposure_at) AS targeting_key_hash,
        entity_family_hash,
        if(
            countIf(isNull(variant)) > 0 OR countDistinct(variant) > 1,
            '__multiple__',
            max(assumeNotNull(variant))
        ) AS variant,
        min(exposure_at) AS first_exposure_ts,
        now64(3) AS snapshot_ts,
        copy_watermark AS watermark_ts
    FROM raw_events
    LEFT JOIN app_identity_generation_tombstones AS generation_tombstones
        ON generation_tombstones.app_id = raw_events.app_id
        AND generation_tombstones.targeting_key_version = splitByChar(':', raw_events.targeting_key_hash)[1]
    WHERE type = 'exposure'
        AND ingest_ts <= copy_watermark
        AND generation_tombstones.app_id = ''
    GROUP BY
        app_id,
        environment_id,
        experiment_id,
        run_id,
        id_type,
        entity_family_hash

TYPE COPY
TARGET_DATASOURCE deduped_exposures
COPY_SCHEDULE @on-demand
COPY_MODE replace
