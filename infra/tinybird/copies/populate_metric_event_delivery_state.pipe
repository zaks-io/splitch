DESCRIPTION >
    Populate one missing Metric Event aggregate state from scoped raw truth.

NODE populate_metric_event_state
SQL >
    %
    {% if not defined(app_id) %}
    {{error('app_id is required')}}
    {% end %}
    {% if not defined(environment_id) %}
    {{error('environment_id is required')}}
    {% end %}
    {% if not defined(event_definition_id) %}
    {{error('event_definition_id is required')}}
    {% end %}
    {% if not defined(dedup_key) %}
    {{error('dedup_key is required')}}
    {% end %}
    {% if not defined(server_received_at) %}
    {{error('server_received_at is required')}}
    {% end %}
    {{max_threads(1)}}
    SELECT
        app_id,
        environment_id,
        toDate(server_received_at) AS event_date,
        event_definition_id,
        id_type,
        server_received_at,
        targeting_key_hash,
        entity_family_hash,
        dedup_key,
        argMinState(
            tuple(event_id, event_definition_version_id, event_name, fields, dimensions, server_received_at, ingest_ts),
            ingest_ts
        ) AS canonical_state
    FROM metric_events
    LEFT JOIN app_identity_generation_tombstones AS generation_tombstones
        ON generation_tombstones.app_id = metric_events.app_id
        AND generation_tombstones.targeting_key_version = splitByChar(':', metric_events.targeting_key_hash)[1]
    WHERE app_id = {{String(app_id)}}
        AND environment_id = {{String(environment_id)}}
        AND event_definition_id = {{String(event_definition_id)}}
        AND dedup_key = {{String(dedup_key)}}
        AND toYYYYMM(server_received_at) = toYYYYMM(toDate({{DateTime64(server_received_at)}}))
        AND generation_tombstones.app_id = ''
    GROUP BY
        app_id,
        environment_id,
        event_date,
        event_definition_id,
        id_type,
        server_received_at,
        targeting_key_hash,
        entity_family_hash,
        dedup_key

TYPE COPY
TARGET_DATASOURCE deduped_metric_events_state
COPY_SCHEDULE @on-demand
COPY_MODE append
