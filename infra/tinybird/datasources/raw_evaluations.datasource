SCHEMA >
    `dedup_key` String `json:$.dedup_key`,
    `event_id` String `json:$.event_id`,
    `organization_id` String `json:$.organization_id`,
    `app_id` String `json:$.app_id`,
    `environment_id` String `json:$.environment_id`,
    `flag_key` String `json:$.flag_key`,
    `sdk_runtime` String `json:$.sdk_runtime`,
    `server_received_at` DateTime64(3) `json:$.server_received_at`,
    `evaluation_count` Nullable(UInt32) `json:$.evaluation_count`,
    `is_batch` Nullable(UInt8) `json:$.is_batch`,
    `is_cached` Nullable(UInt8) `json:$.is_cached`,
    `has_exposure` Nullable(UInt8) `json:$.has_exposure`

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(server_received_at)"
ENGINE_SORTING_KEY "organization_id, app_id, environment_id, server_received_at"
ENGINE_TTL "toDateTime(server_received_at) + toIntervalDay(90)"
TOKEN raw_events_ingest APPEND
# DEDUP_KEY=dedup_key
