SCHEMA >
    `dedup_key` String `json:$.dedup_key`,
    `app_id` String `json:$.app_id`,
    `environment_id` String `json:$.environment_id`,
    `experiment_id` String `json:$.experiment_id`,
    `run_id` String `json:$.run_id`,
    `id_type` String `json:$.id_type`,
    `targeting_key_hash` String `json:$.targeting_key_hash`,
    `variant` Nullable(String) `json:$.variant`,
    `type` LowCardinality(String) `json:$.type`,
    `event_id` String `json:$.event_id`,
    `counterfactual` UInt8 `json:$.counterfactual`,
    `source_id` String `json:$.source_id`,
    `client_timestamp` Nullable(DateTime64(3)) `json:$.client_timestamp`,
    `server_received_at` DateTime64(3) `json:$.server_received_at`,
    `exposure_at` DateTime64(3) `json:$.exposure_at` DEFAULT server_received_at,
    `ingest_ts` DateTime64(3) `json:$.ingest_ts` DEFAULT now64(3),
    `activation_ts` Nullable(DateTime64(3)) `json:$.activation_ts`,
    `is_holdover` UInt8 `json:$.is_holdover`,
    `sdk_version` Nullable(String) `json:$.sdk_version`

FORWARD_QUERY >
    SELECT
        dedup_key,
        app_id,
        environment_id,
        experiment_id,
        run_id,
        id_type,
        targeting_key_hash,
        variant,
        type,
        event_id,
        counterfactual,
        source_id,
        CAST(client_timestamp, 'Nullable(DateTime64(3))') AS client_timestamp,
        server_received_at,
        server_received_at AS exposure_at,
        ingest_ts,
        activation_ts,
        is_holdover,
        sdk_version

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(server_received_at)"
ENGINE_SORTING_KEY "app_id, environment_id, experiment_id, run_id, server_received_at, targeting_key_hash"
ENGINE_TTL "toDateTime(server_received_at) + toIntervalDay(90)"
TOKEN raw_events_ingest APPEND
# DEDUP_KEY=dedup_key
