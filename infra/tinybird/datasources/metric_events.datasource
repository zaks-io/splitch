DESCRIPTION >
    Append-only raw Metric Events, separate from Exposure and Activation facts.

SCHEMA >
    `dedup_key` String `json:$.dedup_key`,
    `event_id` String `json:$.event_id`,
    `app_id` String `json:$.app_id`,
    `environment_id` String `json:$.environment_id`,
    `event_definition_id` String `json:$.event_definition_id`,
    `event_definition_version_id` String `json:$.event_definition_version_id`,
    `event_name` String `json:$.event_name`,
    `id_type` LowCardinality(String) `json:$.id_type`,
    `targeting_key_hash` String `json:$.targeting_key_hash`,
    `fields` String `json:$.fields`,
    `dimensions` String `json:$.dimensions`,
    `server_received_at` DateTime64(3) `json:$.server_received_at`,
    `ingest_ts` DateTime64(6) `json:$.ingest_ts` DEFAULT now64(6)

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(server_received_at)"
ENGINE_SORTING_KEY "app_id, environment_id, event_definition_id, server_received_at, id_type, targeting_key_hash"
ENGINE_TTL "toDateTime(server_received_at) + toIntervalDay(90)"
TOKEN raw_events_ingest APPEND

# DEDUP_KEY=dedup_key
