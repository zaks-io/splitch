{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gitleaks", "tb"],
  "ignoreDependencies": ["cloudflare"],
  "stryker": {
    "config": ["stryker.base.json", "packages/*/stryker.config.json"]
  },
  "ignore": [".agents/**", ".claude/**"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/check-cli-mcp-parity.ts",
        "scripts/release/check-published-version.mjs",
        "scripts/release/constants.mjs",
        "fixtures/external-dark-launch-product/resolve.mjs"
      ]
    },
    "apps/control-panel": {
      "vite": false,
      "ignore": ["vite.config.ts"],
      "ignoreDependencies": ["@cloudflare/vite-plugin", "@tailwindcss/vite", "@vitejs/plugin-react"]
    },
    "packages/contracts": {
      "entry": ["src/sdk-data-plane-surface.ts", "src/leaves/**/*.ts"]
    },
    "apps/cli": {
      "ignoreDependencies": ["@hono/zod-openapi", "@sentry/node", "tsx", "zod"]
    }
  }
}
