{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gitleaks", "tb"],
  "ignoreDependencies": ["cloudflare", "esbuild"],
  "stryker": {
    "config": ["stryker.base.mjs", "packages/*/stryker.config.mjs"]
  },
  "ignore": [".agents/**", "fixtures/convex-sdk-consumer/**", "fixtures/ssr-sdk-consumer/**"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/check-cli-mcp-parity.ts",
        "scripts/lib/repo-file-sweep.d.mts",
        "scripts/release/constants.mjs",
        "fixtures/external-dark-launch-product/resolve.mjs"
      ]
    },
    "apps/control-panel": {
      "vite": false,
      "ignore": ["vite.config.ts"],
      "ignoreDependencies": ["@cloudflare/vite-plugin", "@tailwindcss/vite", "@vitejs/plugin-react"]
    },
    "apps/marketing": {},
    "packages/stats": {
      "vitest": {
        "config": ["vitest.config.ts", "vitest.*.config.ts"]
      }
    },
    "packages/contracts": {
      "entry": ["src/sdk-data-plane-surface.ts", "src/leaves/**/*.ts"]
    },
    "packages/sdk": {
      "entry": ["src/contract-surface-assignability.ts"],
      "ignoreDependencies": ["@splitch/control-plane-sdk", "@splitch/evaluation-core"]
    },
    "packages/convex": {
      "entry": ["src/component/_generated/*.ts"]
    },
    "examples/convex": {
      "entry": ["convex/*.ts", "convex/_generated/*.{js,ts}"]
    },
    "apps/cli": {
      "ignoreDependencies": ["@sentry/node", "tsx"]
    }
  }
}
