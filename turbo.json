{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["biome.json", "tsconfig.base.json"],
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "SPLITCH_PLATFORM_TARGET",
    "AUTH_API_ORIGIN",
    "AUTH_JWKS_URI",
    "CONTROL_PLANE_ORIGIN",
    "TINYBIRD_API_URL"
  ],
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", "build/**"],
      "inputs": ["$TURBO_DEFAULT$"],
      "env": [
        "SPLITCH_PLATFORM_TARGET",
        "AUTH_API_ORIGIN",
        "AUTH_JWKS_URI",
        "CONTROL_PLANE_ORIGIN",
        "TINYBIRD_API_URL"
      ]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "stats:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "stats:golden": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "stats:property": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "stats:simulation": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "test:mutation": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["reports/mutation/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "deploy": {
      "cache": false
    },
    "deploy:dry-run": {
      "cache": false
    },
    "d1:migrate:local": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "migrate:local": {
      "cache": false
    },
    "provision": {
      "cache": false
    },
    "tb": {
      "cache": false
    },
    "tinybird:deploy:check": {
      "cache": false
    },
    "tinybird:deploy:production": {
      "cache": false
    },
    "tinybird:local": {
      "cache": false
    },
    "wrangler": {
      "cache": false
    },
    "wrangler:types": {
      "cache": false
    }
  }
}
