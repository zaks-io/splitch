{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["biome.json", "tsconfig.base.json"],
  "globalEnv": ["CI", "NODE_ENV"],
  "globalPassThroughEnv": [
    "GITHUB_RUN_ID",
    "SPLITCH_SMOKE_APP_ID",
    "SPLITCH_SMOKE_CLIENT_ID",
    "SPLITCH_SMOKE_ENVIRONMENT_ID",
    "SPLITCH_SMOKE_FLAG_ID",
    "SPLITCH_SMOKE_FLAG_KEY",
    "SPLITCH_SMOKE_ORG_ID",
    "SPLITCH_SMOKE_RUN_ID"
  ],
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", "build/**", ".wrangler/deploy/**"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "@splitch/control-panel#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", "build/**", ".wrangler/deploy/**"],
      "inputs": ["$TURBO_DEFAULT$"],
      "env": [
        "SPLITCH_PLATFORM_TARGET",
        "CLOUDFLARE_ENV",
        "SPLITCH_GENERATED_WRANGLER_ENV",
        "SENTRY_RELEASE",
        "SENTRY_RELEASE_BASE",
        "VITE_SENTRY_DSN",
        "VITE_SENTRY_RELEASE",
        "VITE_SPLITCH_PLATFORM_TARGET"
      ]
    },
    "@splitch/marketing#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", "build/**", ".wrangler/deploy/**"],
      "inputs": ["$TURBO_DEFAULT$"],
      "env": ["CLOUDFLARE_ENV", "SPLITCH_GENERATED_WRANGLER_ENV"]
    },
    "@splitch/cli#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/spec/quickstart.md",
        "$TURBO_ROOT$/fixtures/external-dark-launch-product/**",
        "$TURBO_ROOT$/scripts/dark-launch/**"
      ],
      "outputs": []
    },
    "@splitch/repo-lint#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/workflows/cli-*.yml",
        "$TURBO_ROOT$/.github/workflows/sdk-*.yml",
        "$TURBO_ROOT$/apps/cli/LICENSE.md",
        "$TURBO_ROOT$/apps/cli/package.json",
        "$TURBO_ROOT$/apps/cli/scripts/**",
        "$TURBO_ROOT$/apps/cli/src/**",
        "$TURBO_ROOT$/apps/cli/tsconfig*.json",
        "$TURBO_ROOT$/apps/cli/tsup*.ts",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/packages/contracts/package.json",
        "$TURBO_ROOT$/packages/contracts/src/**",
        "$TURBO_ROOT$/packages/sdk/LICENSE.md",
        "$TURBO_ROOT$/packages/sdk/package.json",
        "$TURBO_ROOT$/packages/sdk/scripts/**",
        "$TURBO_ROOT$/packages/sdk/src/**",
        "!$TURBO_ROOT$/packages/sdk/src/generated/**",
        "$TURBO_ROOT$/packages/sdk/tsconfig*.json",
        "$TURBO_ROOT$/packages/sdk/tsup*.ts",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/scripts/release/**"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#format:check": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#spec:lint": {
      "inputs": ["docs/spec/**", "scripts/spec-lint.mjs"],
      "outputs": []
    },
    "//#check:cli-mcp-parity": {
      "dependsOn": ["@splitch/sdk#build"],
      "inputs": [
        "scripts/check-cli-mcp-parity.ts",
        "scripts/lib/**",
        "apps/cli/src/**",
        "apps/mcp-server/src/**",
        "packages/contracts/src/**"
      ],
      "outputs": []
    },
    "//#test:scripts": {
      "inputs": [
        "scripts/**",
        ".github/workflows/**",
        ".github/actions/**",
        "apps/control-panel/playwright.config.ts",
        "package.json"
      ],
      "outputs": []
    },
    "@splitch/control-panel#test:connect-snippet": {
      "dependsOn": ["@splitch/sdk#build"],
      "inputs": ["scripts/connect-snippet-compile.mjs", "src/lib/connect-snippet.ts"],
      "outputs": []
    },
    "@splitch/mcp-server#generate": {
      "inputs": [
        "$TURBO_ROOT$/CONTEXT.md",
        "$TURBO_ROOT$/docs/spec/quickstart.md",
        "$TURBO_ROOT$/scripts/generate-mcp-resource-files.mjs"
      ],
      "outputs": ["src/mcp-resource-files.generated.ts"]
    },
    "@splitch/mcp-server#build": {
      "dependsOn": ["^build", "@splitch/mcp-server#generate"],
      "outputs": ["dist/**", ".output/**", "build/**", ".wrangler/deploy/**"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "@splitch/mcp-server#typecheck": {
      "dependsOn": ["^build", "@splitch/mcp-server#generate"],
      "outputs": []
    },
    "@splitch/mcp-server#test": {
      "dependsOn": ["^build", "@splitch/mcp-server#generate"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["SPLITCH_PLATFORM_TARGET"]
    },
    "stats:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "stats:audit": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "stats:golden": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "stats:property": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "stats:simulation": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "test:mutation": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["reports/mutation/**"]
    },
    "shared-preview:smoke": {
      "cache": false,
      "outputs": ["playwright-report/shared-preview/**", "test-results/shared-preview/**"],
      "passThroughEnv": ["SPLITCH_SMOKE_CLIENT_SECRET"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_RELEASE",
        "SENTRY_RELEASE_BASE",
        "SPLITCH_DEPLOYED_COMMIT_SHA",
        "SENTRY_URL",
        "SPLITCH_REQUIRE_SENTRY_SOURCE_MAP_ENV",
        "SPLITCH_REQUIRE_WORKER_SECRET_ENV",
        "SENTRY_DSN",
        "ACCESS_TOKEN_SECRET",
        "ASSERTION_SIGNING_SECRET",
        "CONTROL_PANEL_DELEGATION_SECRET",
        "EVALUATION_PRIVACY_SALT",
        "EXPOSURE_TICKET_KEY",
        "SPLITCH_DEPLOY_GATE_TOKEN",
        "SPLITCH_EVENT_INGEST_TOKEN",
        "MCP_CONTROL_PLANE_DELEGATION_SECRET",
        "MCP_EVALUATION_DELEGATION_SECRET",
        "MCP_ANALYSIS_DELEGATION_SECRET",
        "TINYBIRD_COPY_TOKEN",
        "TINYBIRD_INGEST_TOKEN",
        "TINYBIRD_RUN_SNAPSHOT_TOKEN",
        "TINYBIRD_READ_TOKEN",
        "TURNSTILE_SECRET",
        "WORKOS_API_KEY",
        "WORKOS_CLIENT_ID",
        "WORKOS_ISSUER",
        "WORKOS_JWKS_URI",
        "SPLITCH_SMOKE_CLIENT_SECRET"
      ]
    },
    "@splitch/evaluation-api#deploy": {
      "dependsOn": ["build", "@splitch/event-ingest-api#deploy"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_RELEASE",
        "SENTRY_RELEASE_BASE",
        "SPLITCH_DEPLOYED_COMMIT_SHA",
        "SENTRY_URL",
        "SPLITCH_REQUIRE_SENTRY_SOURCE_MAP_ENV",
        "SPLITCH_REQUIRE_WORKER_SECRET_ENV",
        "SENTRY_DSN",
        "ACCESS_TOKEN_SECRET",
        "ASSERTION_SIGNING_SECRET",
        "CONTROL_PANEL_DELEGATION_SECRET",
        "EVALUATION_PRIVACY_SALT",
        "EXPOSURE_TICKET_KEY",
        "SPLITCH_DEPLOY_GATE_TOKEN",
        "SPLITCH_EVENT_INGEST_TOKEN",
        "MCP_CONTROL_PLANE_DELEGATION_SECRET",
        "MCP_EVALUATION_DELEGATION_SECRET",
        "MCP_ANALYSIS_DELEGATION_SECRET",
        "TINYBIRD_COPY_TOKEN",
        "TINYBIRD_INGEST_TOKEN",
        "TINYBIRD_RUN_SNAPSHOT_TOKEN",
        "TINYBIRD_READ_TOKEN",
        "TURNSTILE_SECRET",
        "WORKOS_API_KEY",
        "WORKOS_CLIENT_ID",
        "WORKOS_ISSUER",
        "WORKOS_JWKS_URI",
        "SPLITCH_SMOKE_CLIENT_SECRET"
      ]
    },
    "deploy:dry-run": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_RELEASE",
        "SENTRY_RELEASE_BASE",
        "SPLITCH_DEPLOYED_COMMIT_SHA",
        "SENTRY_URL",
        "SPLITCH_REQUIRE_SENTRY_SOURCE_MAP_ENV",
        "SPLITCH_REQUIRE_WORKER_SECRET_ENV",
        "SENTRY_DSN",
        "ACCESS_TOKEN_SECRET",
        "ASSERTION_SIGNING_SECRET",
        "CONTROL_PANEL_DELEGATION_SECRET",
        "EVALUATION_PRIVACY_SALT",
        "EXPOSURE_TICKET_KEY",
        "SPLITCH_DEPLOY_GATE_TOKEN",
        "SPLITCH_EVENT_INGEST_TOKEN",
        "MCP_CONTROL_PLANE_DELEGATION_SECRET",
        "MCP_EVALUATION_DELEGATION_SECRET",
        "MCP_ANALYSIS_DELEGATION_SECRET",
        "TINYBIRD_COPY_TOKEN",
        "TINYBIRD_INGEST_TOKEN",
        "TINYBIRD_RUN_SNAPSHOT_TOKEN",
        "TINYBIRD_READ_TOKEN",
        "TURNSTILE_SECRET",
        "WORKOS_API_KEY",
        "WORKOS_CLIENT_ID",
        "WORKOS_ISSUER",
        "WORKOS_JWKS_URI",
        "SPLITCH_SMOKE_CLIENT_SECRET"
      ]
    },
    "@splitch/evaluation-api#deploy:dry-run": {
      "dependsOn": ["build", "@splitch/event-ingest-api#deploy:dry-run"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_RELEASE",
        "SENTRY_RELEASE_BASE",
        "SPLITCH_DEPLOYED_COMMIT_SHA",
        "SENTRY_URL",
        "SPLITCH_REQUIRE_SENTRY_SOURCE_MAP_ENV",
        "SPLITCH_REQUIRE_WORKER_SECRET_ENV",
        "SENTRY_DSN",
        "ACCESS_TOKEN_SECRET",
        "ASSERTION_SIGNING_SECRET",
        "CONTROL_PANEL_DELEGATION_SECRET",
        "EVALUATION_PRIVACY_SALT",
        "EXPOSURE_TICKET_KEY",
        "SPLITCH_DEPLOY_GATE_TOKEN",
        "SPLITCH_EVENT_INGEST_TOKEN",
        "MCP_CONTROL_PLANE_DELEGATION_SECRET",
        "MCP_EVALUATION_DELEGATION_SECRET",
        "MCP_ANALYSIS_DELEGATION_SECRET",
        "TINYBIRD_COPY_TOKEN",
        "TINYBIRD_INGEST_TOKEN",
        "TINYBIRD_RUN_SNAPSHOT_TOKEN",
        "TINYBIRD_READ_TOKEN",
        "TURNSTILE_SECRET",
        "WORKOS_API_KEY",
        "WORKOS_CLIENT_ID",
        "WORKOS_ISSUER",
        "WORKOS_JWKS_URI",
        "SPLITCH_SMOKE_CLIENT_SECRET"
      ]
    },
    "//#d1:migrate:local": {
      "cache": false
    },
    "//#d1:migrate:populated": {
      "cache": false,
      "dependsOn": ["//#d1:migrate:local"]
    },
    "//#secrets:range": {
      "cache": false
    },
    "//#secrets:staged": {
      "cache": false
    },
    "//#knip": {
      "dependsOn": ["@splitch/cli#build", "@splitch/sdk#build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!.github/**"],
      "outputs": []
    },
    "migrate": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    "migrate:shared-preview": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    "migrate:production": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    "migrate:local": {
      "cache": false
    },
    "provision": {
      "cache": false
    },
    "tb": {
      "cache": false
    },
    "tinybird:deploy:check": {
      "cache": false
    },
    "tinybird:deploy:production": {
      "cache": false
    },
    "//#tinybird:local": {
      "cache": false
    },
    "wrangler": {
      "cache": false
    },
    "wrangler:types": {
      "cache": false
    },
    "@splitch/stats#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/package.json"],
      "outputs": []
    },
    "@splitch/sdk#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/contracts/src/**",
        "$TURBO_ROOT$/scripts/release/**"
      ],
      "outputs": ["dist/**", "src/generated/**"]
    },
    "@splitch/sdk#typecheck": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/contracts/src/**"],
      "outputs": []
    },
    "@splitch/sdk#test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/contracts/src/**"],
      "outputs": []
    },
    "@splitch/sdk#pack:dry-run": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@splitch/sdk#pack:check": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@splitch/sdk#size:check": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@splitch/sdk#test:consumer-smoke": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@splitch/sdk#test:browser-pagehide": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@splitch/cli#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "tsconfig*.json",
        "tsup*.ts",
        "package.json",
        "$TURBO_ROOT$/scripts/release/**"
      ],
      "outputs": ["dist/**"]
    },
    "@splitch/cli#pack:dry-run": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@splitch/cli#pack:check": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@splitch/cli#test:consumer-smoke": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
