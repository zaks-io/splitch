{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["biome.json", "tsconfig.base.json"],
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "SPLITCH_PLATFORM_TARGET",
    "AUTH_API_ORIGIN",
    "AUTH_JWKS_URI",
    "CONTROL_PLANE_ORIGIN",
    "TINYBIRD_API_URL"
  ],
  "globalPassThroughEnv": [
    "GITHUB_RUN_ID",
    "SPLITCH_SMOKE_APP_ID",
    "SPLITCH_SMOKE_CLIENT_ID",
    "SPLITCH_SMOKE_CLIENT_SECRET",
    "SPLITCH_SMOKE_ENVIRONMENT_ID",
    "SPLITCH_SMOKE_FLAG_ID",
    "SPLITCH_SMOKE_FLAG_KEY",
    "SPLITCH_SMOKE_ORG_ID",
    "SPLITCH_SMOKE_RUN_ID"
  ],
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", "build/**"],
      "inputs": ["$TURBO_DEFAULT$"],
      "env": [
        "SPLITCH_PLATFORM_TARGET",
        "AUTH_API_ORIGIN",
        "AUTH_JWKS_URI",
        "CONTROL_PLANE_ORIGIN",
        "TINYBIRD_API_URL"
      ]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "stats:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "stats:golden": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "stats:property": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "stats:simulation": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "test:mutation": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["reports/mutation/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    "@splitch/evaluation-api#deploy": {
      "dependsOn": ["build", "@splitch/event-ingest-api#deploy"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    "deploy:dry-run": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    "@splitch/evaluation-api#deploy:dry-run": {
      "dependsOn": ["build", "@splitch/event-ingest-api#deploy:dry-run"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    "d1:migrate:local": {
      "cache": false
    },
    "migrate": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    "migrate:shared-preview": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    "migrate:production": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    "migrate:local": {
      "cache": false
    },
    "provision": {
      "cache": false
    },
    "tb": {
      "cache": false
    },
    "tinybird:deploy:check": {
      "cache": false
    },
    "tinybird:deploy:production": {
      "cache": false
    },
    "tinybird:local": {
      "cache": false
    },
    "wrangler": {
      "cache": false
    },
    "wrangler:types": {
      "cache": false
    }
  }
}
